#T TEMPLATE component.zen (pcb 0.4, build-verified on 0.4.95 and 0.4.96). Save as components/<MfrDir>/<Value>/<Value>.zen.
#T Replace every @@TOKEN@@ from the datasheet; one left in code fails the build, one left in a comment or docstring does
#T not, so `grep -rn '@@\|^#T' <package dir>` must print nothing. Delete this header block.
#T Non-op-amp parts: replace the io block, pins{} and the check block per the checklist B category set; keep the
#T helpers (_ROOT .. _within) verbatim. A part with a ground pin references abs-max rows to that pin, not _GND.
#T Numbers and limits live in <value>_limits.zen (limits.zen.template). This file holds io, helpers, checks, Component.
#T Keep the helper block (_ROOT .. _within) and _limit() verbatim; add helpers only if a new check shape is needed.
"""@@VALUE@@ @@one-line description@@, @@grade@@ grade, @@package@@ (@@package code@@).
DS: @@DS_URL@@, @@DS_REV@@. Limits: ./@@basepart_lc@@_limits.zen.
Checks are DC steady-state. Transients, overshoot, hot-plug ringing and load dump are not covered.
Every instance must give each checked input a bounded voltage, or the checks report UNVERIFIED.
Verified: pcb @@versions run through test/matrix.sh@@ (test/matrix.sh, @@N@@/@@N@@ cases)."""

load("@stdlib/units.zen", "Temperature", "Voltage")
load("./@@basepart_lc@@_limits.zen", "ABS_IN", "ABS_SPAN", "OP_SPAN", "TA_GRADE", "VCM_HEADROOM")

# Every abs-max row is a check below or one line here:
# UNCHECKED: <row> (DS p.<P>, <table>); <reason>; owner: module|board|layout|assembly.
# UNCHECKED: @@OUT pin abs max@@ (DS p.<P>, Absolute Maximum Ratings); OUT is driven, rarely given a voltage; owner: module.
# UNCHECKED: operating TA abs max (DS p.<P>); covered by temp_grade, which is stricter.
# UNCHECKED: TJ max (DS p.<P>); needs dissipation and theta-JA; owner: board.
# UNCHECKED: storage temperature, ESD HBM/CDM (DS p.<P>); owner: assembly.

V_POS = io(Power)  # DS p.<P> pin <N>, V+
V_NEG = io(Net)  # DS p.<P> pin <N>, V-: GND or a negative rail, so Net + cast at the pin
IN_P = io(Net)  # DS p.<P> pin <N>, +IN
IN_N = io(Net)  # DS p.<P> pin <N>, -IN
OUT = io(Net)  # DS p.<P> pin <N>, OUT
ambient = config(Temperature, optional=True, help="Board ambient range")
derate = config(float, default=1.0, help="Project derating factor, applied to abs-max limits only")
waive_vcm = config(str, default="", help="Rationale for inputs outside the 25°C (V-)+x to (V+)-x range")

_ROOT = len(builtin.current_module_path()) == 0  # built standalone, not instantiated
_GND = Voltage("0V")  # reference for GND-referenced abs-max rows (pass as ref to _rel)
check(derate > 0 and derate <= 1.0, "derate must be in (0, 1]; >1 would loosen abs max")


def _limit(name, fn, inputs, severity, waiver=""):
    # Unset input: UNVERIFIED warning, never a silent pass. Waiver drops a warning to advice.
    if waiver and severity != "warning":
        error("only warning-level checks can be waived: " + name)
    unset = [k for k, v in inputs.items() if v == None]
    if unset:

        def _unverified(_m):
            error("UNVERIFIED " + name + ": no value for " + ", ".join(unset))

        builtin.add_electrical_check(name=name, check_fn=_unverified, severity="advice" if _ROOT else "warning")
    else:
        builtin.add_electrical_check(name=name, check_fn=fn, inputs=inputs, severity="advice" if waiver else severity)


def _toleranced(_m, v, rail):
    check(v.max == 0 or v.min != v.max, rail + " has no tolerance; worst case not assessed")


def _rel(_m, v, ref, lim, k):  # limit referred to another pin; worst case both ways; k shrinks magnitudes only
    lo, hi = v.min - ref.max, v.max - ref.min
    lo_lim = lim.min * k if lim.min < 0 else lim.min
    hi_lim = lim.max * k if lim.max > 0 else lim.max
    check(lo >= lo_lim and hi <= hi_lim, "%s to %s V outside %s to %s V (derate %s)" % (lo, hi, lo_lim, hi_lim, k))


def _band(_m, v, lo, hi, off):  # (lo)+off <= v <= (hi)-off, worst case against both rails; off is a float in volts
    check(
        v.min >= lo.max + off and v.max <= hi.min - off,
        "%s to %s V outside (V-)+%s to (V+)-%s" % (v.min, v.max, off, off),
    )


def _within(_m, v, lim):
    check(v.min >= lim.min and v.max <= lim.max, str(v) + " outside " + str(lim))


_VP, _VN = V_POS.voltage, V_NEG.voltage  # .voltage is None until the instance's net has a voltage
_limit("vpos_tol", _toleranced, {"v": _VP, "rail": "V+"}, "warning")
_limit("vneg_tol", _toleranced, {"v": _VN, "rail": "V-"}, "warning")
_limit("abs_span", _rel, {"v": _VP, "ref": _VN, "lim": ABS_SPAN, "k": derate}, "error")
_limit("op_span", _rel, {"v": _VP, "ref": _VN, "lim": OP_SPAN, "k": 1.0}, "error")
for pin, net in {"IN_P": IN_P, "IN_N": IN_N}.items():
    _limit("tol_" + pin, _toleranced, {"v": net.voltage, "rail": pin}, "warning")
    _limit("abs_" + pin, _rel, {"v": net.voltage, "ref": _GND, "lim": ABS_IN, "k": derate}, "error")
    _limit(
        "vcm_" + pin, _band, {"v": net.voltage, "lo": _VN, "hi": _VP, "off": VCM_HEADROOM.value}, "warning", waive_vcm
    )
_limit("temp_grade", _within, {"v": ambient, "lim": TA_GRADE}, "error")

Component(
    name="@@VALUE@@",
    symbol=Symbol(library="./@@VALUE@@.kicad_sym"),
    part=Part(mpn="@@MPN@@", manufacturer="@@MFR_NAME@@", datasheet="@@DS_URL@@"),
    pins={
        "V+": V_POS,
        "V-": Power(V_NEG, voltage=V_NEG.voltage),
        "+IN": IN_P,
        "-IN": IN_N,
        "OUT": OUT,
    },
    # properties={"alternatives": ["<MPN with other reel suffix or wider grade>"]},  # form-fit-function-identical only
)
