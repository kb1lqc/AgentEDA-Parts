#T TEMPLATE test/harness.zen. Save as components/<MfrDir>/<Value>/test/harness.zen. Replace @@TOKENS@@.
# Harness for @@VALUE@@ checks. Defaults = nominal passing case. Other cases via --config; "unset" leaves a value off.
#T Convention: EVERY input (rails, signals, ambient) is a config that accepts "unset"; every net is named
#T (an unnamed Net() is an error); an unset optional config is omitted with **kwargs LAST (None cannot be passed
#T to a typed config). Add one config per io and per waiver of the component.
#T Comment every default with its range and why it passes (DS test condition, inside which limit), e.g.
#T `# 14.25 to 15.75 V: DS test condition VS = ±15 V, span inside 4.5-36 V`.
@@VALUE@@ = Module("../@@VALUE@@.zen")

vp = config(str, default="@@NOM_VP@@")  # rail with tolerance, e.g. "15V 5%"
vn = config(str, default="@@NOM_VN@@")  # "GND" gives a Ground net; a voltage string a negative rail
vinp = config(str, default="@@NOM_INP@@")
vinn = config(str, default="@@NOM_INN@@")
ta = config(str, default="@@NOM_TA@@")  # inside the grade, e.g. "-40°C to 85°C"
derate = config(float, default=1.0)
waive_vcm = config(str, default="")


def _net(name, v):
    return Net(name) if v == "unset" else Net(name, voltage=v)


V_POS = Power("V_POS") if vp == "unset" else Power("V_POS", voltage=vp)
V_NEG = Ground("GND") if vn == "GND" else (Power("V_NEG") if vn == "unset" else Power("V_NEG", voltage=vn))
@@VALUE@@(
    name="U1",
    V_POS=V_POS,
    V_NEG=V_NEG,
    IN_P=_net("IN_P", vinp),
    IN_N=_net("IN_N", vinn),
    OUT=Net("OUT"),
    derate=derate,
    waive_vcm=waive_vcm,
    **({} if ta == "unset" else {"ambient": ta}),
)
