{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hook_post_edit.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(python tools/stamp.py:*)",
      "Bash(python3 tools/stamp.py:*)",
      "Bash(./tools/stamp.py:*)",
      "Bash(tools/stamp.py:*)",
      "Bash(python */tools/stamp.py*)",
      "Bash(python3 */tools/stamp.py*)",
      "Bash(python3.* *tools/stamp.py*)",
      "Bash(*/tools/stamp.py*)",
      "Bash(*tools/stamp.py*)"
    ]
  }
}
