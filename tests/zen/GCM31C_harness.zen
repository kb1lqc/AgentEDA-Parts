# Test harness for the generated Murata GCM31C capacitor series wrapper (tests/test_zen.py copies it next to GCM31C.zen and
# builds it).
# Defaults: GCM31C5C2J103FX03 (10,000pF, 630Vdc, C0G, ±1%), a mid-catalog part; tolerance given so
#   the selection is unique. 12V 5% across the part (worst case 12.6 V, inside 630 V, either polarity); derate 1.0;
#   ambient -40 degC to 85 degC, inside the -55 degC to 125 degC operating range.
U = Module("./GCM31C.zen")

value = config(str, default="10nF")  # catalog capacitance
rated = config(str, default="630V")  # catalog rated DC voltage
dielectric = config(str, default="C0G")  # catalog dielectric: X7R or C0G (both listed)
tolerance = config(str, default="+/-1%")  # printed tolerance, ASCII; "" lets the wrapper choose when it is unique
va = config(str, default="12V 5%")  # P1 voltage
vb = config(str, default="0V")  # P2 voltage
ta = config(str, default="-40°C to 85°C")
derate = config(float, default=1.0)

U(
    name="C1",
    value=value,
    rated_v=rated,
    dielectric=dielectric,
    tolerance=tolerance,
    P1=Net("A") if va == "unset" else Power("A", voltage=va),
    P2=Power("B", voltage=vb),
    derate=derate,
    **({} if ta == "unset" else {"ambient": ta}),
)
