# Test harness for the generated Murata GCM21A capacitor series wrapper (tests/test_zen.py copies it next to GCM21A.zen and
# builds it).
# Defaults: GCM21A5C2E101FX01 (100 pF, 250 V, C0G, +/-1 %), the C0G reference part; 100 pF 250 V C0G comes in
#   +/-1/2/5 %, so the tolerance is given. 48 V +/-5 % across the part (worst case 50.4 V, inside 250 V, either polarity);
#   derate 1.0; ambient -40 degC to 85 degC, inside the -55 degC to 125 degC C0G operating range.
U = Module("./GCM21A.zen")

value = config(str, default="100pF")  # catalog capacitance
rated = config(str, default="250V")  # catalog rated DC voltage
dielectric = config(str, default="C0G")  # catalog dielectric: X7R or C0G (both listed)
tolerance = config(str, default="+/-1%")  # printed tolerance, ASCII; "" lets the wrapper choose when it is unique
va = config(str, default="48V 5%")  # P1 voltage
vb = config(str, default="0V")  # P2 voltage
ta = config(str, default="-40°C to 85°C")
derate = config(float, default=1.0)

U(
    name="C1",
    value=value,
    rated_v=rated,
    dielectric=dielectric,
    tolerance=tolerance,
    P1=Net("A") if va == "unset" else Power("A", voltage=va),
    P2=Power("B", voltage=vb),
    derate=derate,
    **({} if ta == "unset" else {"ambient": ta}),
)
