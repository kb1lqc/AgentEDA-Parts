# Test harness for the generated STM32H723ZET6 wrapper (tests/test_zen.py copies it next to the wrapper and builds it).
# Defaults are a nominal passing 3.3 V design, VSS and VSSA = Ground (0 V):
#   VDD 3.3 V 5 % (3.135-3.465 V): inside rec-op 1.62-3.6 V. VDDA 3.3 V 5 %: inside 1.62-3.6 V.
#   VREF+ 3.0 V 1 % (2.97-3.03 V): inside 1.62 V to VDDA(min) 3.135 V. Declared apart from VDDA because each net's
#   range is independent (VREF+ tied to VDDA with the same 5 % gives a warning, waivable: case vref_tied_waived).
#   VBAT 3.0 V 5 % (2.85-3.15 V): inside 1.2-3.6 V (partial row: warning) and abs max 4.0 V (error). VDD33USB 3.3 V 5 %: inside 0-3.6 V.
#   BOOT0 0 V: inside 0-9 V. NRST 0-3.3 V and PDR_ON 3.3 V 5 % (3.465 V max): inside -0.3-4.0 V.
#   GPIOs and VCAP: no voltage declared (GPIO unchecked: direction set by firmware; VCAP part-driven).
#   Ambient -40 degC to 85 degC, inside the suffix-6 range.
U = Module("./STM32H723ZET6.zen")

vdd = config(str, default="3.3V 5%")
vdda = config(str, default="3.3V 5%")
vref = config(str, default="3.0V 1%")
vbat = config(str, default="3.0V 5%")
vusb = config(str, default="3.3V 5%")
boot0 = config(str, default="0V")
nrst = config(str, default="0V to 3.3V")
pdron = config(str, default="3.3V 5%")
ta = config(str, default="-40°C to 85°C")
waive = config(str, default="")  # rationale for waive_vbat_op (CASES set it)
waive_vref = config(str, default="")  # rationale for waive_adc16_vref_plus_ge2 (CASES set it)


def _net(name, v):  # "unset" = a net with no voltage, which must report UNVERIFIED
    return Net(name) if v == "unset" else Net(name, voltage=v)


U(
    name="U1",
    PE2=Net("PE2"),
    PE3=Net("PE3"),
    PE4=Net("PE4"),
    PE5=Net("PE5"),
    PE6=Net("PE6"),
    VBAT=_net("VBAT", vbat),
    PC13=Net("PC13"),
    PC14_OSC32_IN=Net("PC14_OSC32_IN"),
    PC15_OSC32_OUT=Net("PC15_OSC32_OUT"),
    PF0=Net("PF0"),
    PF1=Net("PF1"),
    PF2=Net("PF2"),
    PF3=Net("PF3"),
    PF4=Net("PF4"),
    PF5=Net("PF5"),
    VSS=Ground("VSS"),
    VDD=_net("VDD", vdd),
    PF6=Net("PF6"),
    PF7=Net("PF7"),
    PF8=Net("PF8"),
    PF9=Net("PF9"),
    PF10=Net("PF10"),
    PH0_OSC_IN=Net("PH0_OSC_IN"),
    PH1_OSC_OUT=Net("PH1_OSC_OUT"),
    NRST=_net("NRST", nrst),
    PC0=Net("PC0"),
    PC1=Net("PC1"),
    PC2_C=Net("PC2_C"),
    PC3_C=Net("PC3_C"),
    VSSA=Ground("VSSA"),
    VREF_P=_net("VREF_P", vref),
    VDDA=_net("VDDA", vdda),
    PA0=Net("PA0"),
    PA1=Net("PA1"),
    PA2=Net("PA2"),
    PA3=Net("PA3"),
    PA4=Net("PA4"),
    PA5=Net("PA5"),
    PA6=Net("PA6"),
    PA7=Net("PA7"),
    PC4=Net("PC4"),
    PC5=Net("PC5"),
    PB0=Net("PB0"),
    PB1=Net("PB1"),
    PB2=Net("PB2"),
    PF11=Net("PF11"),
    PF12=Net("PF12"),
    PF13=Net("PF13"),
    PF14=Net("PF14"),
    PF15=Net("PF15"),
    PG0=Net("PG0"),
    PG1=Net("PG1"),
    PE7=Net("PE7"),
    PE8=Net("PE8"),
    PE9=Net("PE9"),
    PE10=Net("PE10"),
    PE11=Net("PE11"),
    PE12=Net("PE12"),
    PE13=Net("PE13"),
    PE14=Net("PE14"),
    PE15=Net("PE15"),
    PB10=Net("PB10"),
    PB11=Net("PB11"),
    VCAP=Net("VCAP"),
    PB12=Net("PB12"),
    PB13=Net("PB13"),
    PB14=Net("PB14"),
    PB15=Net("PB15"),
    PD8=Net("PD8"),
    PD9=Net("PD9"),
    PD10=Net("PD10"),
    PD11=Net("PD11"),
    PD12=Net("PD12"),
    PD13=Net("PD13"),
    PD14=Net("PD14"),
    PD15=Net("PD15"),
    PG2=Net("PG2"),
    PG3=Net("PG3"),
    PG4=Net("PG4"),
    PG5=Net("PG5"),
    PG6=Net("PG6"),
    PG7=Net("PG7"),
    PG8=Net("PG8"),
    VDD33USB=_net("VDD33USB", vusb),
    PC6=Net("PC6"),
    PC7=Net("PC7"),
    PC8=Net("PC8"),
    PC9=Net("PC9"),
    PA8=Net("PA8"),
    PA9=Net("PA9"),
    PA10=Net("PA10"),
    PA11=Net("PA11"),
    PA12=Net("PA12"),
    PA13=Net("PA13"),
    PA14=Net("PA14"),
    PA15=Net("PA15"),
    PC10=Net("PC10"),
    PC11=Net("PC11"),
    PC12=Net("PC12"),
    PD0=Net("PD0"),
    PD1=Net("PD1"),
    PD2=Net("PD2"),
    PD3=Net("PD3"),
    PD4=Net("PD4"),
    PD5=Net("PD5"),
    PD6=Net("PD6"),
    PD7=Net("PD7"),
    PG9=Net("PG9"),
    PG10=Net("PG10"),
    PG11=Net("PG11"),
    PG12=Net("PG12"),
    PG13=Net("PG13"),
    PG14=Net("PG14"),
    PG15=Net("PG15"),
    PB3=Net("PB3"),
    PB4=Net("PB4"),
    PB5=Net("PB5"),
    PB6=Net("PB6"),
    PB7=Net("PB7"),
    BOOT0=_net("BOOT0", boot0),
    PB8=Net("PB8"),
    PB9=Net("PB9"),
    PE0=Net("PE0"),
    PE1=Net("PE1"),
    PDR_ON=_net("PDR_ON", pdron),
    waive_vbat_op=waive,
    waive_adc16_vref_plus_ge2=waive_vref,
    **({} if ta == "unset" else {"ambient": ta}),
)
