# Test harness for the series fixture wrapper (tests/test_series.py copies it next to RSER1.zen and builds it).
# Defaults: 240 ohm, 4.5 V +/-1 % across the part (rated sqrt(0.1 W x 240 ohm) = 4.9 V), industrial ambient.
U = Module("./RSER1.zen")

value = config(str, default="240ohm")
va = config(str, default="4.5V 1%")  # P1 voltage; worst case 4.545 V
vb = config(str, default="0V")  # P2 voltage
ta = config(str, default="-40°C to 85°C")  # inside the -55 to 155 degC range
derate = config(float, default=1.0)

U(
    name="R1",
    value=value,
    derate=derate,
    P1=Net("A") if va == "unset" else Power("A", voltage=va),
    P2=Power("B", voltage=vb),
    **({} if ta == "unset" else {"ambient": ta}),
)
