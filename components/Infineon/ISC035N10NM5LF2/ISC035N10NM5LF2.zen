"""ISC035N10NM5LF2: 100 V N-channel OptiMOS 5 Linear FET 2 (hot swap / e-fuse), 164 A, 3.5 mohm max, PG-TDSON-8-59.
GENERATED from component.toml by `python3 -m lib.zen`; do not edit. Source of truth: component.toml and
calc.py (numbers, cites, equations). DS: https://www.infineon.com, Revision 2.3 (2025-11-07).
Checks are DC steady-state on the voltages each instance declares. They do not cover transients, overshoot,
hot-plug ringing or load dump. A checked net with no declared voltage reports UNVERIFIED (a warning).
Analysis (worst case, tables, plots) is done in Python: see README.md and calc.py."""

load("@stdlib/units.zen", "Voltage")

# UNCHECKED: id_tc25: Continuous drain current, TC = 25 degC (DS p.3, Table 2 Maximum ratings, Continuous drain current ID (row 1)); not a voltage; owner: module
# UNCHECKED: id_tc100: Continuous drain current, TC = 100 degC (DS p.3, Table 2 Maximum ratings, Continuous drain current ID (row 2)); not a voltage; owner: module
# UNCHECKED: id_pcb: Continuous drain current, PCB-limited (DS p.3, Table 2 Maximum ratings, Continuous drain current ID (row 3), footnote 2); not a voltage; owner: module
# UNCHECKED: id_pulse: Pulsed drain current (DS p.3, Table 2 Maximum ratings, Pulsed drain current ID,pulse (footnote 3: Diagrams 3 and 4)); not a voltage; owner: module
# UNCHECKED: ptot_tc25: Power dissipation, TC = 25 degC (DS p.3, Table 2 Maximum ratings, Power dissipation Ptot (row 1)); not a voltage; owner: module
# UNCHECKED: ptot_pcb: Power dissipation, PCB-limited (DS p.3, Table 2 Maximum ratings, Power dissipation Ptot (row 2), footnote 2); not a voltage; owner: module
# UNCHECKED: tj_tstg: Operating and storage temperature Tj, Tstg (DS p.3, Table 2 Maximum ratings, Operating and storage temperature Tj, Tstg); TJ: needs dissipation x RthJA; owner: module (Tstg part: owner: assembly)
# UNCHECKED: eas: Avalanche energy, single pulse (DS p.3, Table 2 Maximum ratings, Avalanche energy, single pulse EAS (footnote 4: Diagram 14)); not a voltage; owner: module

# Pins: component.toml [[pin]]. power_in/power_out pins are Net io cast to Power at the pin, so a negative rail or
# GND can drive them; ground-named pins are Ground.
# pin 1 S, passive: Source, discrete MOSFET terminal; pins 1 to 3 are one source node (DS p.1 pin diagram 'Source Pin 1-3')
# pin 2 S, passive: Source, discrete MOSFET terminal; same source node as pin 1
# pin 3 S, passive: Source, discrete MOSFET terminal; same source node as pin 1
S = io(Net)
# pin 4 G, passive: Gate, discrete MOSFET terminal (DS p.1 pin diagram 'Gate Pin 4')
G = io(Net)
# pin 5 D, passive: Drain, discrete MOSFET terminal; pins 5 to 8 and the tab are one drain node (DS p.1 'Drain Pin 5-8, tab'). The drain tab (exposed pad) has no DS number and is not a separate pin: the footprint makes it pad 5 (a real pad on the drain net), overlapping the drain lead pads 5-8.
# pin 6 D, passive: Drain, discrete MOSFET terminal; same drain node as pin 5
# pin 7 D, passive: Drain, discrete MOSFET terminal; same drain node as pin 5
# pin 8 D, passive: Drain, discrete MOSFET terminal; same drain node as pin 5
D = io(Net)

derate = config(float, default=1.0, help="Project derating factor in (0, 1]; shrinks abs-max only")
v_vds_rating = config(
    Voltage,
    optional=True,
    help="Declared worst-case range of V(D) - V(S) from the module's worst-case analysis; replaces the independent net ranges when set",
)
v_vgs = config(
    Voltage,
    optional=True,
    help="Declared worst-case range of V(G) - V(S) from the module's worst-case analysis; replaces the independent net ranges when set",
)

_ROOT = len(builtin.current_module_path()) == 0  # built standalone, not instantiated
check(derate > 0 and derate <= 1.0, "derate must be in (0, 1]; >1 would loosen abs max")


def _limit(name, fn, inputs, severity, waiver=""):
    # Unset input: UNVERIFIED warning, never a silent pass. Waiver drops a warning to advice.
    if waiver and severity != "warning":
        error("only warning-level checks can be waived: " + name)
    unset = [k for k, v in inputs.items() if v == None]
    if unset:

        def _unverified(_m):
            error("UNVERIFIED " + name + ": no value for " + ", ".join(unset))

        builtin.add_electrical_check(name=name, check_fn=_unverified, severity="advice" if _ROOT else "warning")
    else:
        builtin.add_electrical_check(name=name, check_fn=fn, inputs=inputs, severity="advice" if waiver else severity)


def _range(_m, v, what, lo=None, hi=None, lo_ref=None, hi_ref=None):
    # Worst case: v.min >= lo + lo_ref.max and v.max <= hi + hi_ref.min (narrowest window). No ref = absolute.
    lo_b = None if lo == None else lo + (0.0 if lo_ref == None else lo_ref.max)
    hi_b = None if hi == None else hi + (0.0 if hi_ref == None else hi_ref.min)
    ok = (lo_b == None or v.min >= lo_b) and (hi_b == None or v.max <= hi_b)
    lo_t = "no limit" if lo_b == None else "%s V" % lo_b
    hi_t = "no limit" if hi_b == None else "%s V" % hi_b
    check(ok, "%s: %s to %s V outside %s to %s" % (what, v.min, v.max, lo_t, hi_t))


def _temp(_m, v, what, lo, hi):
    # Temperatures are kelvin floats in Zener; messages in degC.
    ok = v.min >= lo and v.max <= hi
    msg = "%s: %s to %s degC outside %s to %s degC"
    check(ok, msg % (what, v.min - 273.15, v.max - 273.15, lo - 273.15, hi - 273.15))


# vds_rating_D: pin D (D) within the limit
#   Drain-source voltage rating: max 100 V (max_ref rel. S)
#   DS p.1, Table 1 Key performance parameters, VDS
#   Severity error: rec_op violated
#   Pin pair: v_vds_rating (config, the module's worst-case analysis of V(D) - V(S)) when set,
#   compared with the same limit and derate; otherwise the two nets' ranges, taken as independent.
def _vds_rating_D_inputs(vd):
    inputs = {"what": "vds_rating_D", "hi": 100.0}
    if vd == None:
        inputs["v"] = D.voltage
        inputs["hi_ref"] = S.voltage
    else:
        inputs["v"] = vd
    return inputs


_limit("vds_rating_D", _range, _vds_rating_D_inputs(v_vds_rating), "error")


# vgs_G: pin G (G) within the limit, x derate
#   Gate-source voltage: min -20 / max 20 V (min_ref rel. S) (max_ref rel. S)
#   DS p.3, Table 2 Maximum ratings, Gate source voltage VGS
#   Severity error: abs_max violated
#   Pin pair: v_vgs (config, the module's worst-case analysis of V(G) - V(S)) when set,
#   compared with the same limit and derate; otherwise the two nets' ranges, taken as independent.
def _vgs_G_inputs(vd):
    inputs = {"what": "vgs_G", "lo": -20.0 * derate, "hi": 20.0 * derate}
    if vd == None:
        inputs["v"] = G.voltage
        inputs["lo_ref"] = S.voltage
        inputs["hi_ref"] = S.voltage
    else:
        inputs["v"] = vd
    return inputs


_limit("vgs_G", _range, _vgs_G_inputs(v_vgs), "error")

Component(
    name="ISC035N10NM5LF2",
    symbol=Symbol(library="./ISC035N10NM5LF2.kicad_sym"),
    part=Part(mpn="ISC035N10NM5LF2", manufacturer="Infineon Technologies", datasheet="https://www.infineon.com"),
    pins={
        "S": S,
        "G": G,
        "D": D,
    },
)
