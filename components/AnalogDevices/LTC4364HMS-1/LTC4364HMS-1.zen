"""LTC4364HMS-1 surge stopper with ideal diode controller, latch-off (-1), H grade, MSOP-16 (LTC MS16, DWG 05-08-1669).
DS: https://www.analog.com/media/en/technical-documentation/data-sheets/ltc4364-1-4364-2.pdf, Rev B (1/23).
Limits and module equations: ./ltc4364_limits.zen (ilim, ilim_fold, rsns_for_ilim, vreg, vin_uv, vin_uv_rise,
vin_ov, r4_max, chg_for_inrush, t_warning, tj_rise).
Checks are DC steady-state. Transients, overshoot, hot-plug ringing and load dump are not covered: declare the normal
operating voltage of each net, not the surge or reverse-battery excursion the part is built to stop.
Every instance must give VCC, OUT, SENSE, OV, UV, SHDN, FB, ENOUT and FLT a bounded voltage, or the checks report
UNVERIFIED. Unused pins (DS p.8-9): FB, OV, FLT, ENOUT to GND; UV to SHDN; SENSE to OUT; SHDN open: declare
VSHDN_FLOAT (2.3 V to 6.5 V). ENOUT pulls up to OUT only (>= 100 kΩ, DS p.13).
ENOUT/FLT are checked to 80 V (DS p.9 pin text), tighter than the 100 V abs max row (DS p.2).
Verified: pcb 0.4.95, 0.4.97 (test/matrix.sh, 127/127 cases)."""

load("@stdlib/units.zen", "Temperature")
load(
    "./ltc4364_limits.zen",
    "ABS_CTRL",
    "ABS_FB",
    "ABS_OD",
    "ABS_OUT",
    "ABS_OUT_VCC",
    "ABS_SENSE_OUT",
    "ABS_VCC",
    "OP_VCC",
    "TA_GRADE",
)

# UNCHECKED: SOURCE -40 V to 100 V (DS p.2); net set by the external back-to-back MOSFETs, never declared; owner: module.
# UNCHECKED: DGATE, HGATE SOURCE-0.3 V to SOURCE+10 V (DS p.2, Note 3 p.5); part-driven gates, internally clamped
#   (pin text says 12 V, DS p.8; drive spec 10-16 V, DS p.3-5); 15 V zener HGATE-SOURCE and DGATE-SOURCE for
#   >= 24 V supplies, CHG >= 6.8 nF HGATE-GND (DS p.8, p.16); owner: module.
# UNCHECKED: SENSE to SOURCE -100 V to 100 V (DS p.2); SOURCE never declared; owner: module (MOSFET VDS rating).
# UNCHECKED: TMR -0.3 V to 5.5 V (DS p.2); timer capacitor node driven by the part; owner: module.
# UNCHECKED: operating ambient -40°C to 125°C (DS p.2); covered by temp_grade (same range, error).
# Not isolable in test/matrix.sh (see test/README.md): abs_VCC lower edge (op_VCC fires first) and abs_OUT_VCC upper
#   edge (op_VCC or abs_OUT fires first) are only seen failing together with the shadowing check.
# UNCHECKED: TJ 150°C max (DS p.2, Pin Configuration); needs dissipation; owner: module (call tj_rise()).
# UNCHECKED: storage -65°C to 150°C (DS p.2); owner: assembly.
# UNCHECKED: lead temperature 300°C, 10 s (DS p.2); owner: assembly.
# ESD HBM/CDM and latch-up: no data in DS.
# Unpowered and reverse inputs: VCC, SHDN, UV, OV, SOURCE, HGATE, DGATE withstand -40 V (DS p.15); guaranteed reverse
#   currents on DS p.3-4; owner: module.

OUT = io(Net)  # DS p.8 pin 1, OUT: output voltage sense (drain of the DGATE MOSFET)
SENSE = io(Net)  # DS p.8 pin 2, SENSE: current sense input, sense resistor to OUT
DGATE = io(Net)  # DS p.8 pin 4, DGATE: ideal diode gate drive
SOURCE = io(Net)  # DS p.8 pin 5, SOURCE: common source of the back-to-back MOSFETs
HGATE = io(Net)  # DS p.8 pin 6, HGATE: surge stopper gate drive
VCC = io(Power)  # DS p.8 pin 8, VCC: 4 V to 80 V, -40 V reverse
SHDN = io(Net)  # DS p.8 pin 9, SHDN (active low)
UV = io(Net)  # DS p.8 pin 10, UV comparator input
OV = io(Net)  # DS p.8 pin 11, OV comparator input
GND = io(Ground)  # DS p.9 pin 12, GND
FLT = io(Net)  # DS p.9 pin 13, FLT (active low), open drain
ENOUT = io(Net)  # DS p.9 pin 14, ENOUT, open drain, pull up to OUT (>= 100 kΩ, DS p.13)
TMR = io(Net)  # DS p.9 pin 15, TMR: fault timer capacitor to GND
FB = io(Net)  # DS p.9 pin 16, FB: output clamp divider; GND disables the clamp
# Pins 3 and 7 are NC, "not internally connected" (DS p.8): omitted, auto NotConnected.
ambient = config(Temperature, optional=True, help="Board ambient range")
derate = config(float, default=1.0, help="Project derating factor, applied to abs-max limits only")

_ROOT = len(builtin.current_module_path()) == 0  # built standalone, not instantiated
check(derate > 0 and derate <= 1.0, "derate must be in (0, 1]; >1 would loosen abs max")


def _limit(name, fn, inputs, severity, waiver=""):
    # Unset input: UNVERIFIED warning, never a silent pass. Waiver drops a warning to advice.
    if waiver and severity != "warning":
        error("only warning-level checks can be waived: " + name)
    unset = [k for k, v in inputs.items() if v == None]
    if unset:

        def _unverified(_m):
            error("UNVERIFIED " + name + ": no value for " + ", ".join(unset))

        builtin.add_electrical_check(name=name, check_fn=_unverified, severity="advice" if _ROOT else "warning")
    else:
        builtin.add_electrical_check(name=name, check_fn=fn, inputs=inputs, severity="advice" if waiver else severity)


def _r3(x):  # round to 3 decimals for stable messages (no round() or %.3f in this Starlark)
    return int(x * 1000 + (0.5 if x >= 0 else -0.5)) / 1000.0


def _toleranced(_m, v, rail):
    check(v.max == 0 or v.min != v.max, rail + " has no tolerance; worst case not assessed")


def _rel(_m, v, ref, lim, k):  # limit referred to another pin; worst case both ways; k shrinks magnitudes only
    lo, hi = v.min - ref.max, v.max - ref.min
    lo_lim = lim.min * k if lim.min < 0 else lim.min
    hi_lim = lim.max * k if lim.max > 0 else lim.max
    check(
        lo >= lo_lim and hi <= hi_lim,
        "%s to %s V outside %s to %s V (derate %s)" % (_r3(lo), _r3(hi), _r3(lo_lim), _r3(hi_lim), k),
    )


def _within(_m, v, lim):
    check(v.min >= lim.min and v.max <= lim.max, str(v) + " outside " + str(lim))


_G = GND.voltage  # DS p.5 Note 2: voltages referenced to GND
_limit("tol_VCC", _toleranced, {"v": VCC.voltage, "rail": "VCC"}, "warning")
_limit("abs_VCC", _rel, {"v": VCC.voltage, "ref": _G, "lim": ABS_VCC, "k": derate}, "error")
_limit("op_VCC", _rel, {"v": VCC.voltage, "ref": _G, "lim": OP_VCC, "k": 1.0}, "error")
for pin, net, lim in [
    ("OV", OV, ABS_CTRL),
    ("UV", UV, ABS_CTRL),
    ("SHDN", SHDN, ABS_CTRL),
    ("OUT", OUT, ABS_OUT),
    ("SENSE", SENSE, ABS_OUT),
    ("FB", FB, ABS_FB),
    ("ENOUT", ENOUT, ABS_OD),
    ("FLT", FLT, ABS_OD),
]:
    _limit("tol_" + pin, _toleranced, {"v": net.voltage, "rail": pin}, "warning")
    _limit("abs_" + pin, _rel, {"v": net.voltage, "ref": _G, "lim": lim, "k": derate}, "error")
_limit("abs_SENSE_OUT", _rel, {"v": SENSE.voltage, "ref": OUT.voltage, "lim": ABS_SENSE_OUT, "k": derate}, "error")
_limit("abs_OUT_VCC", _rel, {"v": OUT.voltage, "ref": VCC.voltage, "lim": ABS_OUT_VCC, "k": derate}, "error")
_limit("temp_grade", _within, {"v": ambient, "lim": TA_GRADE}, "error")

Component(
    name="LTC4364HMS-1",
    symbol=Symbol(library="./LTC4364HMS-1.kicad_sym"),
    part=Part(
        mpn="LTC4364HMS-1#TRPBF",
        manufacturer="Analog Devices",
        datasheet="https://www.analog.com/media/en/technical-documentation/data-sheets/ltc4364-1-4364-2.pdf",
    ),
    pins={
        "OUT": OUT,
        "SENSE": SENSE,
        "DGATE": DGATE,
        "SOURCE": SOURCE,
        "HGATE": HGATE,
        "VCC": VCC,
        "SHDN": SHDN,
        "UV": UV,
        "OV": OV,
        "GND": GND,
        "FLT": FLT,
        "ENOUT": ENOUT,
        "TMR": TMR,
        "FB": FB,
    },
    properties={"alternatives": ["LTC4364HMS-1#PBF"]},
)
