"""LTC4364 datasheet limits and equations, shared by LTC4364HMS-1.zen and by modules (load() this file).
DS: https://www.analog.com/media/en/technical-documentation/data-sheets/ltc4364-1-4364-2.pdf, Rev B (1/23).
Raw guaranteed values, never derated here. Abs max: DS p.2; all voltages referenced to GND unless otherwise specified
(DS p.5, Note 2). "Full temp" = the ● rows of the Electrical Characteristics (DS p.3-5), H grade -40°C to 125°C.
Helpers return plain floats in SI units (V, A, ohm, F, s) as (min, max) worst-case pairs where a range applies."""

load("@stdlib/units.zen", "Temperature", "Voltage")

ABS_VCC = Voltage("-40V to 100V")  # DS p.2, Absolute Maximum Ratings, Supply Voltage VCC
ABS_CTRL = Voltage("-40V to 100V")  # DS p.2, Absolute Maximum Ratings, SOURCE, OV, UV, SHDN Voltages
ABS_OUT = Voltage("-20V to 100V")  # DS p.2, Absolute Maximum Ratings, OUT, SENSE Voltages
ABS_SENSE_OUT = Voltage("-30V to 30V")  # DS p.2, Absolute Maximum Ratings, Voltage Difference (SENSE to OUT)
ABS_OUT_VCC = Voltage("-100V to 100V")  # DS p.2, Absolute Maximum Ratings, Voltage Difference (OUT to VCC)
ABS_FB = Voltage("-0.3V to 5.5V")  # DS p.2, Absolute Maximum Ratings, FB, TMR Voltages
# ENOUT, FLT: DS p.2 Absolute Maximum Ratings says -0.3 V to 100 V, but DS p.9 Pin Functions says each "can withstand
# up to 80V" (and ILEAK is tested at 80 V, DS p.4). The lower value is used.
ABS_OD = Voltage("-0.3V to 80V")
OP_VCC = Voltage("4V to 80V")  # DS p.3, Electrical Characteristics, VCC Operating Supply Range, full temp
TA_GRADE = Temperature("-40°C to 125°C")  # DS p.2, Absolute Maximum Ratings, Operating Ambient, LTC4364H
TJ_MAX = Temperature("150°C")  # DS p.2, Pin Configuration, MS package TJMAX (not in the abs max table)
THETA_JA = 120  # °C/W, DS p.2, Pin Configuration, MS package (board not stated)

# Full temp guaranteed values for module calculations (DS p.3-5, VCC = 12 V unless noted). Not checked in the component.
DVSNS_HI = (0.043, 0.057)  # V, current limit sense voltage, VCC = 4-80 V, OUT = 2.5 V to VCC, -40°C to 125°C row (p.3)
DVSNS_LO = (
    0.018,
    0.032,
)  # V, foldback, VCC = 4-80 V, OUT = 0 V to 1.5 V, -40°C to 125°C row (p.3); 1.5-2.5 V unspecified
VFB = (1.22, 1.28)  # V, FB servo voltage, VCC = 12 V to 80 V (p.3)
IFB = 1e-6  # A, FB input current max magnitude, FB = 1.25 V (p.3)
VTH_UV = (1.22, 1.28)  # V, UV falling threshold, VCC = 4-80 V (p.4)
UV_HYST = (0.025, 0.080)  # V, UV hysteresis (p.4)
VTH_OV = (1.22, 1.28)  # V, OV rising threshold, VCC = 4-80 V (p.4); OV hysteresis 12 mV is typical only
IIN_UVOV = 1e-6  # A, UV/OV input current max magnitude, UV = OV = 1.25 V (p.4)
VUV_RST = (0.5, 0.7)  # V, UV latch-reset threshold, -1 only (p.4); hold below for > 10 µs after cool-down (p.15)
VSHDN_TH = (0.5, 2.2)  # V, SHDN threshold (p.4); latch reset by SHDN low > 200 µs (p.15)
VSHDN_FLOAT = (2.3, 6.5)  # V, SHDN open-circuit voltage, VCC = 12-80 V (p.4): declare this when SHDN is left open
IHGATE_UP = (10e-6, 30e-6)  # A, HGATE pull-up magnitude, VCC = HGATE = DGATE = SOURCE = 12 V (p.3)
CHG_MIN = 6.8e-9  # F, HGATE to GND capacitor, "6.8nF or larger" (p.8)
ICC_MAX = 750e-6  # A, VCC supply current, VCC = SOURCE = SENSE = OUT = 12 V (p.3)
ITMR_WARN = (3e-6, 7e-6)  # A, TMR warning pull-up magnitude (p.4)
DVTMR = (0.075, 0.125)  # V, TMR warning window (p.4)
ENOUT_RPU_MIN = 100e3  # ohm, ENOUT pull-up to OUT (p.13)
COUT_MIN = 22e-6  # F, OUT bypass, low-ESR electrolytic (p.8, p.18)


def ilim(rsns):
    """(min, max) current limit in A for RSNS in ohms (DS p.12: ILIM = dVSNS / RSNS). Valid for OUT >= 2.5 V;
    OUT 1.5-2.5 V is not specified (DS p.3), a module must not rely on it."""
    check(rsns > 0, "rsns must be > 0")
    return (DVSNS_HI[0] / rsns, DVSNS_HI[1] / rsns)


def ilim_fold(rsns):
    """(min, max) foldback current limit in A with OUT <= 1.5 V (DS p.3, p.8): a load above the min cannot start."""
    check(rsns > 0, "rsns must be > 0")
    return (DVSNS_LO[0] / rsns, DVSNS_LO[1] / rsns)


def rsns_for_ilim(i_load):
    """Largest RSNS (ohms) whose minimum current limit still passes i_load (A) (DS p.12, dVSNS min 43 mV).
    Snap down with an E-series helper in the module and re-check ilim() and ilim_fold()."""
    check(i_load > 0, "i_load must be > 0")
    return DVSNS_HI[0] / i_load


def vreg(r_top, r_bot):
    """(min, max) output clamp voltage for the FB divider OUT-r_top-FB-r_bot-GND, ohms (DS p.19; VFB, IFB DS p.3)."""
    check(r_top > 0 and r_bot > 0, "divider resistors must be > 0")
    k = 1 + r_top / r_bot
    return (VFB[0] * k - IFB * r_top, VFB[1] * k + IFB * r_top)


# UV/OV divider VIN-r1-UV-r2-OV-r3-GND (DS p.19). Pin currents up to IIN_UVOV either way, both pins: nodal analysis gives
# VIN = Vth*k + Iuv*r1 + Iov*r1*r3/(r2+r3) at the UV trip, and Vth*k + Iuv*r1 + Iov*(r1+r2) at the OV trip.
def _div_check(r1, r2, r3):
    check(r1 > 0 and r2 >= 0 and r3 > 0, "divider resistors must be > 0 (r2 may be 0)")


def vin_uv(r1, r2, r3):
    """(min, max) falling UV trip on VIN, the turn-off point (DS p.19; VTH_UV, IIN DS p.4)."""
    _div_check(r1, r2, r3)
    k, e = (r1 + r2 + r3) / (r2 + r3), IIN_UVOV * r1 * (1 + r3 / (r2 + r3))
    return (VTH_UV[0] * k - e, VTH_UV[1] * k + e)


def vin_uv_rise(r1, r2, r3):
    """(min, max) rising UV trip on VIN, the guaranteed turn-on point (VTH_UV + UV_HYST, DS p.4)."""
    _div_check(r1, r2, r3)
    k, e = (r1 + r2 + r3) / (r2 + r3), IIN_UVOV * r1 * (1 + r3 / (r2 + r3))
    return ((VTH_UV[0] + UV_HYST[0]) * k - e, (VTH_UV[1] + UV_HYST[1]) * k + e)


def vin_ov(r1, r2, r3):
    """(min, max) rising OV trip on VIN (DS p.19; VTH_OV, IIN DS p.4)."""
    _div_check(r1, r2, r3)
    k, e = (r1 + r2 + r3) / r3, IIN_UVOV * (2 * r1 + r2)
    return (VTH_OV[0] * k - e, VTH_OV[1] * k + e)


def r4_max(vin_min):
    """Largest VCC series resistor (ohms) keeping VCC >= 4 V at vin_min (V) (DS p.19: (VIN(min) - 4 V) / ICC).
    ICC is specified at VCC = 12 V only (DS p.3). Declare VCC as the pin voltage after R4 and the clamp zener."""
    check(vin_min > OP_VCC.min, "vin_min must exceed 4 V")
    return (vin_min - OP_VCC.min) / ICC_MAX


def chg_for_inrush(i_inrush, c_load):
    """Smallest HGATE capacitor (F) keeping inrush <= i_inrush (A) into c_load (F), using the max HGATE pull-up
    (DS p.17: CHG = IHGATE(UP) * CL / IINRUSH), never below the 6.8 nF minimum (DS p.8)."""
    check(i_inrush > 0 and c_load > 0, "i_inrush and c_load must be > 0")
    return max(CHG_MIN, IHGATE_UP[1] * c_load / i_inrush)


def t_warning(ctmr):
    """(min, max) fault warning time in s for the TMR capacitor (DS p.14: CTMR * dVTMR / ITMR(UP) warning).
    The cool-down equation (DS p.15) uses typical values and is not provided."""
    check(ctmr > 0, "ctmr must be > 0")
    return (ctmr * DVTMR[0] / ITMR_WARN[1], ctmr * DVTMR[1] / ITMR_WARN[0])


def tj_rise(p):
    """Controller junction rise in °C above ambient for p W dissipated in the part itself (VCC * ICC, THETA_JA DS p.2).
    Tj max 150°C. The external MOSFETs' SOA is separate (DS p.16-17)."""
    return p * THETA_JA
