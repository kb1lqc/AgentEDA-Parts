# Harness for LTC4364HMS-1 checks. Defaults = nominal passing case. Other cases via --config; "unset" leaves a value off.
LTC4364HMS_1 = Module("../LTC4364HMS-1.zen")

# Each default is chosen to pass every check with margin, so `pcb build` on the package stays green. All 5% values
# are toleranced, so every tol_* check passes; all sit far inside their abs-max limits.
vcc = config(str, default="12V 5%")  # 11.4 to 12.6 V: the DS test condition VCC = 12 V (DS p.3), inside 4-80 V
vout = config(str, default="12V 5%")  # same as VCC: OUT - VCC is -1.2 to 1.2 V, inside ±100 V
vsense = config(str, default="12V 5%")  # same as OUT: SENSE - OUT is -1.2 to 1.2 V, inside ±30 V
vov = config(str, default="1V 5%")  # 0.95 to 1.05 V, below the 1.22 V OV threshold (DS p.4): no overvoltage fault
vuv = config(str, default="2V 5%")  # 1.9 to 2.1 V, above the 1.28 V UV threshold (DS p.4): enabled
vshdn = config(str, default="12V 5%")  # above the 2.2 V SHDN threshold max (DS p.4): enabled
vfb = config(str, default="1V 5%")  # 0.95 to 1.05 V, inside -0.3 to 5.5 V
venout = config(str, default="12V 5%")  # pulled up to OUT, as the DS requires (DS p.13)
vflt = config(str, default="3.3V 5%")  # a logic pull-up rail, inside -0.3 to 80 V
ta = config(str, default="-40°C to 85°C")  # industrial board range, inside the H grade -40°C to 125°C
derate = config(float, default=1.0)  # no derating, so the raw DS limits are tested


def _net(name, v):  # "unset" gives a named net with no voltage, which must report UNVERIFIED
    return Net(name) if v == "unset" else Net(name, voltage=v)


LTC4364HMS_1(
    name="U1",
    VCC=Power("VCC") if vcc == "unset" else Power("VCC", voltage=vcc),
    GND=Ground("GND"),
    OUT=_net("OUT", vout),
    SENSE=_net("SENSE", vsense),
    OV=_net("OV", vov),
    UV=_net("UV", vuv),
    SHDN=_net("SHDN", vshdn),
    FB=_net("FB", vfb),
    ENOUT=_net("ENOUT", venout),
    FLT=_net("FLT", vflt),
    DGATE=Net("DGATE"),
    SOURCE=Net("SOURCE"),
    HGATE=Net("HGATE"),
    TMR=Net("TMR"),
    derate=derate,
    **({} if ta == "unset" else {"ambient": ta}),
)
