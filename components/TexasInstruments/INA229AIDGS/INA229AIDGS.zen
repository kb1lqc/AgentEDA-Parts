# vcm_rec_IN_P: pin IN+ (IN_P) within the limit
#   Common-mode input range: min -0.3 / max 85 V
#   DS p.4, 6.3 Recommended Operating Conditions, VCM, Common-mode input range
#   Conditions: over operating free-air temperature range (unless otherwise noted)
#   Severity error: rec_op violated
_limit("vcm_rec_IN_P", _range, {"v": IN_P.voltage, "what": "vcm_rec_IN_P", "lo": -0.3, "hi": 85.0}, "error")

# vcm_rec_IN_N: pin IN- (IN_N) within the limit
#   Common-mode input range: min -0.3 / max 85 V
