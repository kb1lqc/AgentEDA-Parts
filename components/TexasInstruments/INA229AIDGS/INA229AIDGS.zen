_limit("vs_rec_VS", _range, {"v": VS.voltage, "what": "vs_rec_VS", "lo": 2.7, "hi": 5.5}, "error")

# ta_rec_ambient: board ambient range inside this range
#   Ambient temperature: min -40 / max 125 degC
#   DS p.4, 6.3 Recommended Operating Conditions, TA, Ambient temperature
#   Severity error: rec_op violated
_limit("ta_rec_ambient", _temp, {"v": ambient, "what": "ta_rec_ambient", "lo": 233.15, "hi": 398.15}, "error")

Component(
    name="INA229AIDGS",
    symbol=Symbol(library="./INA229AIDGS.kicad_sym"),
    part=Part(
