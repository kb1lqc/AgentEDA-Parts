# vio_abs_MOSI: pin MOSI (MOSI) within the limit, x derate
#   Digital input/output voltage, MOSI, MISO, SCLK, ALERT: min -0.3 / max 0.3 V (min_ref rel. GND) (max_ref rel. VS)
#   DS p.3, 6.1 Absolute Maximum Ratings, VIO, MOSI, MISO, SCLK, ALERT
#   Conditions: over operating free-air temperature range (unless otherwise noted)
#   Severity error: abs_max violated
_limit(
    "vio_abs_MOSI",
    _range,
    {
        "v": MOSI.voltage,
        "what": "vio_abs_MOSI",
        "lo": -0.3 * derate,
        "lo_ref": GND.voltage,
        "hi": 0.3 * derate,
        "hi_ref": VS.voltage,
    },
    "error",
)

# vio_abs_SCLK: pin SCLK (SCLK) within the limit, x derate
#   Digital input/output voltage, MOSI, MISO, SCLK, ALERT: min -0.3 / max 0.3 V (min_ref rel. GND) (max_ref rel. VS)
#   DS p.3, 6.1 Absolute Maximum Ratings, VIO, MOSI, MISO, SCLK, ALERT
#   Conditions: over operating free-air temperature range (unless otherwise noted)
#   Severity error: abs_max violated
_limit(
    "vio_abs_SCLK",
    _range,
    {
        "v": SCLK.voltage,
        "what": "vio_abs_SCLK",
        "lo": -0.3 * derate,
        "lo_ref": GND.voltage,
        "hi": 0.3 * derate,
        "hi_ref": VS.voltage,
    },
    "error",
