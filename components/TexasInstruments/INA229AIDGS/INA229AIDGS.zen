_limit("vcm_rec_IN_N", _range, {"v": IN_N.voltage, "what": "vcm_rec_IN_N", "lo": -0.3, "hi": 85.0}, "error")

# vs_rec_VS: pin VS (VS) within the limit
#   Operating supply range: min 2.7 / max 5.5 V
#   DS p.4, 6.3 Recommended Operating Conditions, VS, Operating supply range
#   Conditions: over operating free-air temperature range (unless otherwise noted)
