#   Pin pair: v_abs_cs_pair (config, the module's worst-case analysis of V(CS+) - V(CS-)) when set,
#   compared with the same limit and derate; otherwise the two nets' ranges, taken as independent.
def _abs_cs_pair_CS_P_inputs(vd):
    inputs = {"what": "abs_cs_pair_CS_P", "lo": -1.0 * derate, "hi": 100.0 * derate}
    if vd == None:
        inputs["v"] = CS_P.voltage
        inputs["lo_ref"] = CS_N.voltage
        inputs["hi_ref"] = CS_N.voltage
    else:
        inputs["v"] = vd
    return inputs


