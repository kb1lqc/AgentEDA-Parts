"""INA821IDGK: Precision instrumentation amplifier, 4.5-36 V.
GENERATED from component.toml by `python3 -m lib.zen`; do not edit. Source of truth: component.toml and
calc.py (numbers, cites, equations). DS: https://www.ti.com/lit/ds/symlink/ina821.pdf, SBOS893D (2020-06).
Checks are DC steady-state on the voltages each instance declares. They do not cover transients, overshoot,
hot-plug ringing or load dump. A checked net with no declared voltage reports UNVERIFIED (a warning).
Analysis (worst case, tables, plots) is done in Python: see README.md and calc.py."""

load("@stdlib/units.zen", "Temperature", "Voltage")

# UNCHECKED: vs_abs: Supply voltage (DS p.5, 7.1 Absolute Maximum Ratings, Supply voltage); printed +/-20 V is a 40 V span (DS p.24, 8.3.5); covered by vs_rec_single (4.5 V to 36 V span, error), which is stricter
# UNCHECKED: vout_abs: Signal output pins (DS p.5, 7.1 Absolute Maximum Ratings, Signal output pins); OUT is driven by the part; owner: module
# UNCHECKED: ta_abs: Operating temperature (DS p.5, 7.1 Absolute Maximum Ratings, Operating Temperature, TA); covered by ta_rec (-40 degC to 125 degC, error), which is stricter
# UNCHECKED: tj_abs: Junction temperature (DS p.5, 7.1 Absolute Maximum Ratings, Junction Temperature, TJ); needs dissipation x rtheta_ja; owner: module
# UNCHECKED: isc_abs: Output short-circuit (DS p.5, 7.1 Absolute Maximum Ratings, Output short-circuit (2)); text rating (Continuous, to VS/2); owner: board
# UNCHECKED: tstg_abs: Storage temperature (DS p.5, 7.1 Absolute Maximum Ratings, Storage Temperature, Tstg); owner: assembly
# UNCHECKED: esd_hbm: Electrostatic discharge, human-body model (DS p.5, 7.2 ESD Ratings, Human-body model (HBM)); owner: assembly
# UNCHECKED: esd_cdm: Electrostatic discharge, charged-device model (DS p.5, 7.2 ESD Ratings, Charged-device model (CDM)); owner: assembly
# UNCHECKED: vs_rec_dual: Supply voltage, dual-supply (DS p.5, 7.3 Recommended Operating Conditions, Supply voltage VS, Dual-supply); same 4.5 V to 36 V span as vs_rec_single, which is checked

# Pins: component.toml [[pin]]. power_in/power_out pins are Net io cast to Power at the pin, so a negative rail or
# GND can drive them; ground-named pins are Ground.
# pin 1 -IN, input: Negative (inverting) input
IN_N = io(Net)
# pin 2 RG1, passive: Gain setting pin; gain resistor RG connects between pin 2 and pin 3. Symbol name RG1 (separate node from pin 3)
RG1 = io(Net)
# pin 3 RG2, passive: Gain setting pin; gain resistor RG connects between pin 2 and pin 3. Symbol name RG2 (separate node from pin 2)
RG2 = io(Net)
# pin 4 +IN, input: Positive (noninverting) input
IN_P = io(Net)
# pin 5 -VS, power_in: Negative supply
VS_N = io(Net)
# pin 6 REF, input: Reference input; must be driven by a low impedance source
REF = io(Net)
# pin 7 OUT, output: Output
OUT = io(Net)
# pin 8 +VS, power_in: Positive supply
VS_P = io(Net)

ambient = config(Temperature, optional=True, help="Board ambient temperature range")
derate = config(float, default=1.0, help="Project derating factor in (0, 1]; shrinks abs-max only")
v_vs_rec_single = config(
    Voltage,
    optional=True,
    help="Declared worst-case range of V(+VS) - V(-VS) from the module's worst-case analysis; replaces the independent net ranges when set",
)
waive_vcm_range_25c = config(str, default="", help="Rationale with a cite for violating vcm_range_25c")
waive_vref_range_25c = config(str, default="", help="Rationale with a cite for violating vref_range_25c")

_ROOT = len(builtin.current_module_path()) == 0  # built standalone, not instantiated
check(derate > 0 and derate <= 1.0, "derate must be in (0, 1]; >1 would loosen abs max")


def _limit(name, fn, inputs, severity, waiver=""):
    # Unset input: UNVERIFIED warning, never a silent pass. Waiver drops a warning to advice.
    if waiver and severity != "warning":
        error("only warning-level checks can be waived: " + name)
    unset = [k for k, v in inputs.items() if v == None]
    if unset:

        def _unverified(_m):
            error("UNVERIFIED " + name + ": no value for " + ", ".join(unset))

        builtin.add_electrical_check(name=name, check_fn=_unverified, severity="advice" if _ROOT else "warning")
    else:
        builtin.add_electrical_check(name=name, check_fn=fn, inputs=inputs, severity="advice" if waiver else severity)


def _range(_m, v, what, lo=None, hi=None, lo_ref=None, hi_ref=None):
    # Worst case: v.min >= lo + lo_ref.max and v.max <= hi + hi_ref.min (narrowest window). No ref = absolute.
    lo_b = None if lo == None else lo + (0.0 if lo_ref == None else lo_ref.max)
    hi_b = None if hi == None else hi + (0.0 if hi_ref == None else hi_ref.min)
    ok = (lo_b == None or v.min >= lo_b) and (hi_b == None or v.max <= hi_b)
    lo_t = "no limit" if lo_b == None else "%s V" % lo_b
    hi_t = "no limit" if hi_b == None else "%s V" % hi_b
    check(ok, "%s: %s to %s V outside %s to %s" % (what, v.min, v.max, lo_t, hi_t))


def _temp(_m, v, what, lo, hi):
    # Temperatures are kelvin floats in Zener; messages in degC.
    ok = v.min >= lo and v.max <= hi
    msg = "%s: %s to %s degC outside %s to %s degC"
    check(ok, msg % (what, v.min - 273.15, v.max - 273.15, lo - 273.15, hi - 273.15))


# vin_abs_IN_P: pin +IN (IN_P) within the limit, x derate
#   Signal input pins, voltage: min -40 / max 40 V
#   DS p.5, 7.1 Absolute Maximum Ratings, Signal input pins, Voltage
#   Conditions: over operating free-air temperature range (unless otherwise noted)
#   Severity error: abs_max violated
_limit(
    "vin_abs_IN_P",
    _range,
    {"v": IN_P.voltage, "what": "vin_abs_IN_P", "lo": -40.0 * derate, "hi": 40.0 * derate},
    "error",
)

# vin_abs_IN_N: pin -IN (IN_N) within the limit, x derate
#   Signal input pins, voltage: min -40 / max 40 V
#   DS p.5, 7.1 Absolute Maximum Ratings, Signal input pins, Voltage
#   Conditions: over operating free-air temperature range (unless otherwise noted)
#   Severity error: abs_max violated
_limit(
    "vin_abs_IN_N",
    _range,
    {"v": IN_N.voltage, "what": "vin_abs_IN_N", "lo": -40.0 * derate, "hi": 40.0 * derate},
    "error",
)

# vref_abs_REF: pin REF (REF) within the limit, x derate
#   Signal input pins, REF pin: min -20 / max 20 V
#   DS p.5, 7.1 Absolute Maximum Ratings, Signal input pins, REF pin
#   Conditions: over operating free-air temperature range (unless otherwise noted)
#   Severity error: abs_max violated
_limit(
    "vref_abs_REF",
    _range,
    {"v": REF.voltage, "what": "vref_abs_REF", "lo": -20.0 * derate, "hi": 20.0 * derate},
    "error",
)


# vs_rec_single_VS_P: pin +VS (VS_P) within the limit
#   Supply voltage, single-supply: min 4.5 / max 36 V (min_ref rel. -VS) (max_ref rel. -VS)
#   DS p.5, 7.3 Recommended Operating Conditions, Supply voltage VS, Single-supply
#   Conditions: single-supply; over operating free-air temperature range
#   Severity error: rec_op violated
#   Pin pair: v_vs_rec_single (config, the module's worst-case analysis of V(+VS) - V(-VS)) when set,
#   compared with the same limit and derate; otherwise the two nets' ranges, taken as independent.
def _vs_rec_single_VS_P_inputs(vd):
    inputs = {"what": "vs_rec_single_VS_P", "lo": 4.5, "hi": 36.0}
    if vd == None:
        inputs["v"] = VS_P.voltage
        inputs["lo_ref"] = VS_N.voltage
        inputs["hi_ref"] = VS_N.voltage
    else:
        inputs["v"] = vd
    return inputs


_limit("vs_rec_single_VS_P", _range, _vs_rec_single_VS_P_inputs(v_vs_rec_single), "error")

# ta_rec_ambient: board ambient range inside this range
#   Specified temperature: min -40 / max 125 degC
#   DS p.5, 7.3 Recommended Operating Conditions, Specified temperature, TA
#   Conditions: specified temperature
#   Severity error: rec_op violated
_limit("ta_rec_ambient", _temp, {"v": ambient, "what": "ta_rec_ambient", "lo": 233.15, "hi": 398.15}, "error")

# vcm_range_25c_IN_P: pin +IN (IN_P) within the limit
#   Operating input range (common-mode): min 2 / max -2 V (min_ref rel. -VS) (max_ref rel. +VS)
#   DS p.6, 7.5 Electrical Characteristics, Operating input range (4), first row
#   Conditions: TA = 25 degC, VS = +/-15 V, RL = 10 kohm, VREF = 0 V, G = 1 (table header)
#   Severity warning: limit holds only at 25C (waivable with waive_<check>)
_limit(
    "vcm_range_25c_IN_P",
    _range,
    {
        "v": IN_P.voltage,
        "what": "vcm_range_25c_IN_P",
        "lo": 2.0,
        "lo_ref": VS_N.voltage,
        "hi": -2.0,
        "hi_ref": VS_P.voltage,
    },
    "warning",
    waive_vcm_range_25c,
)

# vcm_range_25c_IN_N: pin -IN (IN_N) within the limit
#   Operating input range (common-mode): min 2 / max -2 V (min_ref rel. -VS) (max_ref rel. +VS)
#   DS p.6, 7.5 Electrical Characteristics, Operating input range (4), first row
#   Conditions: TA = 25 degC, VS = +/-15 V, RL = 10 kohm, VREF = 0 V, G = 1 (table header)
#   Severity warning: limit holds only at 25C (waivable with waive_<check>)
_limit(
    "vcm_range_25c_IN_N",
    _range,
    {
        "v": IN_N.voltage,
        "what": "vcm_range_25c_IN_N",
        "lo": 2.0,
        "lo_ref": VS_N.voltage,
        "hi": -2.0,
        "hi_ref": VS_P.voltage,
    },
    "warning",
    waive_vcm_range_25c,
)

# vref_range_25c_REF: pin REF (REF) within the limit
#   Reference input voltage range: min 0 / max 0 V (min_ref rel. -VS) (max_ref rel. +VS)
#   DS p.7, 7.5 Electrical Characteristics, REFERENCE INPUT, Voltage range
#   Conditions: TA = 25 degC, VS = +/-15 V (table header)
#   Severity warning: limit holds only at 25C (waivable with waive_<check>)
_limit(
    "vref_range_25c_REF",
    _range,
    {
        "v": REF.voltage,
        "what": "vref_range_25c_REF",
        "lo": 0.0,
        "lo_ref": VS_N.voltage,
        "hi": 0.0,
        "hi_ref": VS_P.voltage,
    },
    "warning",
    waive_vref_range_25c,
)

Component(
    name="INA821IDGK",
    symbol=Symbol(library="./INA821IDGK.kicad_sym"),
    part=Part(
        mpn="INA821IDGKR", manufacturer="Texas Instruments", datasheet="https://www.ti.com/lit/ds/symlink/ina821.pdf"
    ),
    pins={
        "-IN": IN_N,
        "RG1": RG1,
        "RG2": RG2,
        "+IN": IN_P,
        "-VS": Power(VS_N, voltage=VS_N.voltage),
        "REF": REF,
        "OUT": OUT,
        "+VS": Power(VS_P, voltage=VS_P.voltage),
    },
    properties={"alternatives": ["INA821IDGKT"]},
)
