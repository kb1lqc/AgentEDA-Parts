# Harness for INA821IDGK checks. Defaults = nominal passing case. Other cases via --config; "unset" leaves a value off.
INA821IDGK = Module("../INA821IDGK.zen")

# Each default is chosen to pass every check with margin, so `pcb build` on the package stays green:
vp = config(str, default="15V 5%")  # 14.25 to 15.75 V: the DS test condition VS = ±15 V (DS p.6 header), with tolerance
vn = config(str, default="-15V 5%")  # -15.75 to -14.25 V; span 28.5 to 31.5 V, inside 4.5-36 V and 0-40 V
vinp = config(str, default="1V 1%")  # 0.99 to 1.01 V, toleranced so tol_IN_P passes; inside vcm -12.25 to 12.25 V
vinn = config(str, default="0V")  # exactly 0 V, exempt from tol_IN_N
vref = config(str, default="0V")  # exactly 0 V (DS test condition VREF = 0 V), exempt from tol_REF
ta = config(str, default="-40°C to 85°C")  # industrial board range, inside the -40°C to 125°C grade
derate = config(float, default=1.0)  # no derating, so the raw DS limits are tested
waive_vcm = config(str, default="")  # empty = not waived
waive_ref = config(str, default="")  # empty = not waived


def _net(name, v):  # "unset" gives a named net with no voltage, which must report UNVERIFIED
    return Net(name) if v == "unset" else Net(name, voltage=v)


V_POS = Power("V_POS") if vp == "unset" else Power("V_POS", voltage=vp)
# vn = "GND" builds the single-supply case (V- tied to ground); "unset" leaves the rail without a voltage.
V_NEG = Ground("GND") if vn == "GND" else (Power("V_NEG") if vn == "unset" else Power("V_NEG", voltage=vn))
INA821IDGK(
    name="U1",
    V_POS=V_POS,
    V_NEG=V_NEG,
    IN_P=_net("IN_P", vinp),
    IN_N=_net("IN_N", vinn),
    RG1=Net("RG1"),
    RG2=Net("RG2"),
    REF=_net("REF", vref),
    OUT=Net("OUT"),
    derate=derate,
    waive_vcm=waive_vcm,
    waive_ref=waive_ref,
    **({} if ta == "unset" else {"ambient": ta}),
)
