"""INA821 datasheet limits and gain equations, shared by INA821IDGK.zen and by modules (load() this file).
DS: https://www.ti.com/lit/ds/symlink/ina821.pdf, SBOS893D (rev. June 2020). Raw guaranteed values, never derated here.
Abs max and rec-op rows apply over the operating free-air range (DS p.5 headers). Full temp = TA -40°C to 125°C."""

load("@stdlib/units.zen", "Current", "Resistance", "Temperature", "Voltage")

# V+ to V- span (checked as V+ - V-): max 40 V from DS p.5, 7.1 Abs Max, Supply voltage ±20 V, and DS p.24, 8.3.5
# ">40 V (±20 V)" damages. Min 0 V is not a DS value: reversed supplies are not rated, so treated as not allowed.
ABS_SPAN = Voltage("0V to 40V")
ABS_IN = Voltage("-40V to 40V")  # DS p.5, 7.1 Abs Max, Signal input pins Voltage; reference unstated, taken to GND
ABS_REF = Voltage("-20V to 20V")  # DS p.5, 7.1 Abs Max, Signal input pins REF pin; reference unstated, taken to GND
OP_SPAN = Voltage("4.5V to 36V")  # DS p.5, 7.3 Rec Op, Supply voltage single 4.5-36 V (dual ±2.25 to ±18 V)
TA_GRADE = Temperature("-40°C to 125°C")  # DS p.5, 7.3 Rec Op, Specified temperature

# 25°C only (DS p.6-7 header TA = 25°C, VS = ±15 V, RL = 10 kΩ); the full-temp VCM row defers to Figures 51-54.
VCM_HEADROOM = Voltage("2V")  # DS p.6, 7.5, VCM Operating input range (V-)+2 to (V+)-2
SWING_HEADROOM = Voltage("0.15V")  # DS p.7, 7.5, OUTPUT Voltage swing (V-)+0.15 to (V+)-0.15, RL = 10 kΩ

# Full temp maxima for module error budgets, not checked here (DS p.6-7, 7.5).
VOSI_MAX = Voltage("80uV")  # VOSI INA821IDGK, TA -40°C to 125°C (specified by characterization, note 3)
VOSO_MAX = Voltage("850uV")  # VOSO, all packages, TA -40°C to 125°C (note 3); VOS(RTI) = VOSI + VOSO / G (note 1)
IB_MAX = Current("2nA")  # IB, TA -40°C to 125°C (no VCM condition stated; 25°C row is VCM = VS/2)
IOS_MAX = Current("2nA")  # IOS, TA -40°C to 125°C
IQ_MAX = Current("870uA")  # IQ vs temperature, TA -40°C to 125°C
GAIN_DRIFT_PPM = (5, 35)  # Gain vs temperature, ppm/°C max, (G = 1, G > 1); excludes RG (note 6)

GAIN_K = Resistance("49.4kohm")  # DS p.20, 8.3.1 Equation 1: G = 1 + 49.4 kΩ / RG
GAIN_RANGE = (1, 10000)  # DS p.6, 7.5 GAIN, Range of gain


def gain(rg):
    """Gain (float) for an RG between RG1 and RG2 (DS p.20, Equation 1)."""
    return (1 + GAIN_K / rg).value


def rg_for_gain(g):
    """Ideal RG for gain g > 1 (DS p.20, Equation 1 solved for RG). G = 1 means RG open; snap with e96() and
    re-check gain(rg) against the requirement. Exact Eq. 1; DS Table 2 values are rounded."""
    check(g > GAIN_RANGE[0] and g <= GAIN_RANGE[1], "gain %s outside (1, 10000] for an RG (DS p.6)" % g)
    return GAIN_K / (g - 1)
