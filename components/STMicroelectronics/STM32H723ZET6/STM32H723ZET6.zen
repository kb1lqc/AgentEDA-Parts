ambient = config(Temperature, optional=True, help="Board ambient temperature range")
derate = config(float, default=1.0, help="Project derating factor in (0, 1]; shrinks abs-max only")
waive_vbat_op = config(str, default="", help="Rationale with a cite for violating vbat_op")
waive_adc16_vref_plus_ge2 = config(str, default="", help="Rationale with a cite for violating adc16_vref_plus_ge2")

_ROOT = len(builtin.current_module_path()) == 0  # built standalone, not instantiated
check(derate > 0 and derate <= 1.0, "derate must be in (0, 1]; >1 would loosen abs max")


def _limit(name, fn, inputs, severity, waiver=""):
    # Unset input: UNVERIFIED warning, never a silent pass. Waiver drops a warning to advice.
    if waiver and severity != "warning":
        error("only warning-level checks can be waived: " + name)
    unset = [k for k, v in inputs.items() if v == None]
    if unset:

        def _unverified(_m):
            error("UNVERIFIED " + name + ": no value for " + ", ".join(unset))

        builtin.add_electrical_check(name=name, check_fn=_unverified, severity="advice" if _ROOT else "warning")
    else:
        builtin.add_electrical_check(name=name, check_fn=fn, inputs=inputs, severity="advice" if waiver else severity)


def _range(_m, v, what, lo=None, hi=None, lo_ref=None, hi_ref=None):
    # Worst case: v.min >= lo + lo_ref.max and v.max <= hi + hi_ref.min (narrowest window). No ref = absolute.
    lo_b = None if lo == None else lo + (0.0 if lo_ref == None else lo_ref.max)
    hi_b = None if hi == None else hi + (0.0 if hi_ref == None else hi_ref.min)
    ok = (lo_b == None or v.min >= lo_b) and (hi_b == None or v.max <= hi_b)
    lo_t = "no limit" if lo_b == None else "%s V" % lo_b
    hi_t = "no limit" if hi_b == None else "%s V" % hi_b
    check(ok, "%s: %s to %s V outside %s to %s" % (what, v.min, v.max, lo_t, hi_t))


def _temp(_m, v, what, lo, hi):
    # Temperatures are kelvin floats in Zener; messages in degC.
    ok = v.min >= lo and v.max <= hi
    msg = "%s: %s to %s degC outside %s to %s degC"
    check(ok, msg % (what, v.min - 273.15, v.max - 273.15, lo - 273.15, hi - 273.15))


# abs_vddx_vss_VBAT: pin VBAT (VBAT) within the limit, x derate
#   External main supply voltage (VDD, VDDLDO, VDDA, VDD33USB, VBAT): min -0.3 / max 4.0 V (min_ref rel. VSS) (max_ref rel. VSS)
#   DS p.88, Table 9. Voltage characteristics, VDDX - VSS (note 1)
#   Severity error: abs_max violated
_limit(
    "abs_vddx_vss_VBAT",
    _range,
    {
        "v": VBAT.voltage,
        "what": "abs_vddx_vss_VBAT",
        "lo": -0.3 * derate,
        "lo_ref": VSS.voltage,
        "hi": 4.0 * derate,
        "hi_ref": VSS.voltage,
    },
    "error",
)

# abs_vin_boot0_BOOT0: pin BOOT0 (BOOT0) within the limit, x derate
#   Input voltage on BOOT0 pin: min 0 / max 9.0 V (min_ref rel. VSS) (max_ref rel. VSS)
#   DS p.88, Table 9. Voltage characteristics, Input voltage on BOOT0 pin
#   Severity error: abs_max violated
_limit(
    "abs_vin_boot0_BOOT0",
    _range,
    {
        "v": BOOT0.voltage,
        "what": "abs_vin_boot0_BOOT0",
        "lo": 0.0,
        "lo_ref": VSS.voltage,
        "hi": 9.0 * derate,
        "hi_ref": VSS.voltage,
    },
    "error",
)

# abs_vin_other_NRST: pin NRST (NRST) within the limit, x derate
#   Input voltage on any other pins (NRST, PDR_ON and others not in the rows above): min -0.3 / max 4.0 V (min_ref rel. VSS) (max_ref rel. VSS)
#   DS p.88, Table 9. Voltage characteristics, Input voltage on any other pins
#   Severity error: abs_max violated
_limit(
    "abs_vin_other_NRST",
    _range,
    {
        "v": NRST.voltage,
        "what": "abs_vin_other_NRST",
        "lo": -0.3 * derate,
        "lo_ref": VSS.voltage,
        "hi": 4.0 * derate,
        "hi_ref": VSS.voltage,
    },
    "error",
)

# abs_vin_other_PDR_ON: pin PDR_ON (PDR_ON) within the limit, x derate
#   Input voltage on any other pins (NRST, PDR_ON and others not in the rows above): min -0.3 / max 4.0 V (min_ref rel. VSS) (max_ref rel. VSS)
#   DS p.88, Table 9. Voltage characteristics, Input voltage on any other pins
#   Severity error: abs_max violated
_limit(
    "abs_vin_other_PDR_ON",
    _range,
    {
        "v": PDR_ON.voltage,
        "what": "abs_vin_other_PDR_ON",
        "lo": -0.3 * derate,
        "lo_ref": VSS.voltage,
        "hi": 4.0 * derate,
        "hi_ref": VSS.voltage,
    },
    "error",
)

# vdd_op_VDD: pin VDD (VDD) within the limit
#   Standard operating voltage, VDD: min 1.62 / max 3.6 V (min_ref rel. VSS) (max_ref rel. VSS)
#   DS p.90, Table 12. General operating conditions, VDD
#   Severity error: rec_op violated
_limit(
    "vdd_op_VDD",
    _range,
    {"v": VDD.voltage, "what": "vdd_op_VDD", "lo": 1.62, "lo_ref": VSS.voltage, "hi": 3.6, "hi_ref": VSS.voltage},
    "error",
)

# vdd33usb_op_nousb_VDD33USB: pin VDD33USB (VDD33USB) within the limit
#   Standard operating voltage, USB domain, USB not used: min 0 / max 3.6 V (min_ref rel. VSS) (max_ref rel. VSS)
#   DS p.90, Table 12. General operating conditions, VDD33USB, USB not used
#   Conditions: USB not used
#   Severity error: rec_op violated
_limit(
    "vdd33usb_op_nousb_VDD33USB",
    _range,
    {
        "v": VDD33USB.voltage,
        "what": "vdd33usb_op_nousb_VDD33USB",
        "lo": 0.0,
        "lo_ref": VSS.voltage,
        "hi": 3.6,
        "hi_ref": VSS.voltage,
    },
    "error",
)

# vdda_op_adc_VDDA: pin VDDA (VDDA) within the limit
#   Analog operating voltage, ADC or COMP used: min 1.62 / max 3.6 V (min_ref rel. VSSA) (max_ref rel. VSSA)
#   DS p.90, Table 12. General operating conditions, VDDA, ADC or COMP used
#   Conditions: ADC or COMP used
#   Severity error: rec_op violated
_limit(
    "vdda_op_adc_VDDA",
    _range,
    {
        "v": VDDA.voltage,
        "what": "vdda_op_adc_VDDA",
        "lo": 1.62,
        "lo_ref": VSSA.voltage,
        "hi": 3.6,
        "hi_ref": VSSA.voltage,
    },
    "error",
)

# vbat_op_VBAT: pin VBAT (VBAT) within the limit
#   Supply voltage for Backup domain: min 1.2 / max 3.6 V (min_ref rel. VSS) (max_ref rel. VSS)
#   DS p.90, Table 12. General operating conditions, VBAT (footnote 2)
#   Severity warning: limit holds only at partial (waivable with waive_<check>)
_limit(
    "vbat_op_VBAT",
    _range,
    {"v": VBAT.voltage, "what": "vbat_op_VBAT", "lo": 1.2, "lo_ref": VSS.voltage, "hi": 3.6, "hi_ref": VSS.voltage},
    "warning",
    waive_vbat_op,
)

# ta_range6_max_power_ambient: board ambient range inside this range
#   Ambient temperature for temperature range 6, maximum power dissipation: min -40 / max 85 degC
#   DS p.91, Table 12. General operating conditions, TA, temperature range 6, maximum power dissipation
#   Conditions: Temperature range 6 (suffix 6), maximum power dissipation
#   Severity error: rec_op violated
_limit(
    "ta_range6_max_power_ambient",
    _temp,
    {"v": ambient, "what": "ta_range6_max_power_ambient", "lo": 233.15, "hi": 358.15},
    "error",
)

# adc16_vref_plus_ge2_VREF_P: pin VREF+ (VREF_P) within the limit
#   Positive reference voltage, VDDA >= 2 V: min 1.62 / max 0 V (max_ref rel. VDDA)
#   DS p.162, Table 80. 16-bit ADC characteristics, VREF+ (VDDA >= 2 V row)
#   Conditions: VDDA >= 2 V
#   Severity warning: limit holds only at partial (waivable with waive_<check>)
_limit(
    "adc16_vref_plus_ge2_VREF_P",
    _range,
    {"v": VREF_P.voltage, "what": "adc16_vref_plus_ge2_VREF_P", "lo": 1.62, "hi": 0.0, "hi_ref": VDDA.voltage},
    "warning",
    waive_adc16_vref_plus_ge2,
)

