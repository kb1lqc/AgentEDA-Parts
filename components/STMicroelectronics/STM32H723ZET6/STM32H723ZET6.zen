# Pins: component.toml [[pin]]. power_in/power_out pins are Net io cast to Power at the pin, so a negative rail or
# GND can drive them; ground-named pins are Ground.
# pin 1 PE2, bidirectional: I/O structure FT_h. TRACECLK, SAI1_CK1, ETH_MII_TXD3, FMC_A23
PE2 = io(Net)
# pin 2 PE3, bidirectional: I/O structure FT_h
PE3 = io(Net)
# pin 3 PE4, bidirectional: I/O structure FT_h. DCMI_D4/PSSI_D4, LCD_B0
PE4 = io(Net)
# pin 4 PE5, bidirectional: I/O structure FT_h. DCMI_D6/PSSI_D6, LCD_G0
PE5 = io(Net)
# pin 5 PE6, bidirectional: I/O structure FT_h. DCMI_D7/PSSI_D7, LCD_G1
PE6 = io(Net)
# pin 6 VBAT, power_in: Backup domain supply, 1.2 V to 3.6 V (Table 12 note 2: min 0 V if VDD present)
VBAT = io(Net)
# pin 7 PC13, bidirectional: I/O structure FT. RTC_TAMP1/RTC_TS, WKUP4. Errata 2.2.6 (LSE disturbed by PC13 transitions)
PC13 = io(Net)
# pin 8 PC14-OSC32_IN, bidirectional: I/O structure FT. OSC32_IN (LSE oscillator input, function after reset is GPIO)
PC14_OSC32_IN = io(Net)
# pin 9 PC15-OSC32_OUT, bidirectional: I/O structure FT. OSC32_OUT (LSE oscillator output, function after reset is GPIO)
PC15_OSC32_OUT = io(Net)
# pin 10 PF0, bidirectional: I/O structure FT_fh. I2C2_SDA, OCTOSPIM_P2_IO0
PF0 = io(Net)
# pin 11 PF1, bidirectional: I/O structure FT_fh. I2C2_SCL, OCTOSPIM_P2_IO1
PF1 = io(Net)
# pin 12 PF2, bidirectional: I/O structure FT_h. I2C2_SMBA
PF2 = io(Net)
# pin 13 PF3, bidirectional: I/O structure FT_ha. ADC3_INP5
PF3 = io(Net)
# pin 14 PF4, bidirectional: I/O structure FT_ha. ADC3_INN5, ADC3_INP9
PF4 = io(Net)
# pin 15 PF5, bidirectional: I/O structure FT_ha. ADC3_INP4
PF5 = io(Net)
# pin 16 VSS, power_in: Ground
# pin 38 VSS, power_in: Ground
# pin 51 VSS, power_in: Ground
# pin 61 VSS, power_in: Ground
# pin 83 VSS, power_in: Ground
# pin 94 VSS, power_in: Ground
# pin 107 VSS, power_in: Ground
# pin 120 VSS, power_in: Ground
# pin 130 VSS, power_in: Ground
VSS = io(Ground)
# pin 17 VDD, power_in: Digital supply, 1.62 V to 3.6 V (Table 12)
# pin 30 VDD, power_in: Digital supply
# pin 39 VDD, power_in: Digital supply
# pin 52 VDD, power_in: Digital supply
# pin 62 VDD, power_in: Digital supply
# pin 72 VDD, power_in: Digital supply
# pin 84 VDD, power_in: Digital supply
# pin 108 VDD, power_in: Digital supply
# pin 121 VDD, power_in: Digital supply
# pin 131 VDD, power_in: Digital supply
# pin 144 VDD, power_in: Digital supply
VDD = io(Net)
# pin 18 PF6, bidirectional: I/O structure FT_ha. ADC3_INN4, ADC3_INP8
PF6 = io(Net)
# pin 19 PF7, bidirectional: I/O structure FT_ha. ADC3_INP3
PF7 = io(Net)
# pin 20 PF8, bidirectional: I/O structure FT_ha. ADC3_INN3, ADC3_INP7
PF8 = io(Net)
# pin 21 PF9, bidirectional: I/O structure FT_ha. ADC3_INP2
PF9 = io(Net)
# pin 22 PF10, bidirectional: I/O structure FT_ha. ADC3_INN2, ADC3_INP6
PF10 = io(Net)
# pin 23 PH0-OSC_IN, bidirectional: I/O structure FT. OSC_IN (HSE oscillator input, function after reset is GPIO)
PH0_OSC_IN = io(Net)
# pin 24 PH1-OSC_OUT, bidirectional: I/O structure FT. OSC_OUT (HSE oscillator output, function after reset is GPIO)
PH1_OSC_OUT = io(Net)
# pin 25 NRST, bidirectional: I/O structure RST. Reset input, active low (DS Table 7, I/O structure RST); bidirectional (open-drain reset output)
NRST = io(Net)
# pin 26 PC0, bidirectional: I/O structure FT_ha. ADC123_INP10
PC0 = io(Net)
# pin 27 PC1, bidirectional: I/O structure FT_ha. ADC123_INN10, ADC123_INP11, RTC_TAMP3, WKUP6
PC1 = io(Net)
