# abs_diag_v3v3_DIAG: pin DIAG (DIAG) within the limit, x derate
#   VDIAG pin DC voltage relative to V3V3: max 0.3 V (max_ref rel. V3V3)
#   DS p.5, Table 2. Absolute maximum ratings, VDIAG (V3V3 + 0.3 V)
#   Severity error: abs_max violated
#   Pin pair: v_abs_diag_v3v3 (config, the module's worst-case analysis of V(DIAG) - V(V3V3)) when set,
#   compared with the same limit and derate; otherwise the two nets' ranges, taken as independent.
def _abs_diag_v3v3_DIAG_inputs(vd):
    inputs = {"what": "abs_diag_v3v3_DIAG", "hi": 0.3 * derate}
    if vd == None:
        inputs["v"] = DIAG.voltage
        inputs["hi_ref"] = V3V3.voltage
    else:
        inputs["v"] = vd
    return inputs


_limit("abs_diag_v3v3_DIAG", _range, _abs_diag_v3v3_DIAG_inputs(v_abs_diag_v3v3), "error")

