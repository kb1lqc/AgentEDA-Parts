    1000000000000: "ERA6AEB105V",  # 1e+06 ohm
}
_KEY = int(value.value * 1e6 + 0.5)
# Part number for an allowed value; any other value takes the first entry and fails value_allowed below.
_MPN_STR = _MPN.get(_KEY, _MPN[47000000])


def _allowed(_m, r, what):
    check(
        _KEY in _MPN,
        "%s: %s ohm is not an allowed value (E24/E96 values from 47 to 1e+06 ohm (E96 only from 100 ohm))" % (what, r),
    )


_ALLOWED_SEVERITY = "advice" if _ROOT else "error"  # standalone build: value is unset
builtin.add_electrical_check(
    name="value_allowed",
    check_fn=_allowed,
    inputs={"r": value.value, "what": "value_allowed"},
    severity=_ALLOWED_SEVERITY,
)


def _rated_voltage(_m, what, r, p, vlim, derate, v1=None, v2=None, va=None):
    # Worst case |V across the part|: v_across (the module's analysis) when set, else the two nets' ranges taken
    # as independent: max(v1.max - v2.min, v2.max - v1.min). Zener has no sqrt, so compare squares:
    # vmax <= derate x min(sqrt(P x R), vlim)  <=>  vmax^2 <= derate^2 x min(P x R, vlim^2).
    if va == None:
        vmax = max(v1.max - v2.min, v2.max - v1.min)
        src = "net ranges"
    else:
        vmax = max(abs(va.min), abs(va.max))
        src = "v_across"
    limit2 = min(p * r, vlim * vlim) * derate * derate
    msg = "%s: up to %s V across the part (from %s), (V across)^2 = %s V^2 > %s V^2 = derate^2 x min(P x R, Vlimit^2) with R = %s ohm, P = %s W, Vlimit = %s V"
    check(vmax * vmax <= limit2, msg % (what, vmax, src, vmax * vmax, limit2, r, p, vlim))


def _rated_inputs(va):
    inputs = {"what": "rated_voltage", "r": value.value, "p": 0.125, "vlim": 100.0, "derate": derate}
    if va == None:
        inputs["v1"] = P1.voltage
        inputs["v2"] = P2.voltage
    else:
        inputs["va"] = va
    return inputs


# category_temp_ambient: board ambient range inside this range
#   Category temperature range: min -55 / max 155 degC
#   DS p.20, Ratings, Category temperature range (degC), all rows of the table (also DS p.19 Features)
#   Severity error: rec_op violated
_limit(
    "category_temp_ambient", _temp, {"v": ambient, "what": "category_temp_ambient", "lo": 218.15, "hi": 428.15}, "error"
)

# rated_voltage: voltage across the part within min(sqrt(P x R), Vlimit), x derate
#   Power rating p85: Power rating at 85 degC: max 0.125 W (DS p.20, Ratings, Power rating (85 degC) (W), ERA6AEB row)
#   Voltage limit v_limit: Limiting element voltage: max 100 V (DS p.20, Ratings, Limiting element voltage (V), ERA6AEB row)
#   Voltage across: v_across (config, the module's worst-case analysis) when set; otherwise the two nets' ranges,
#   taken as independent. Evaluated for the configured value. Error: a rated part voltage is exceeded.
#   Not checked here: power derating above 70 degC (curve) is the module's job, calc.rated_power;
#   above 70 degC ambient this check is optimistic.
_limit("rated_voltage", _rated_voltage, _rated_inputs(v_across), "error")

Component(
    name="ERA-6AEB",
    symbol=Symbol(library="./ERA-6AEB.kicad_sym"),
    part=Part(mpn=_MPN_STR, manufacturer="Panasonic"),
    pins={
        "1": P1,
        "2": P2,
    },
)
