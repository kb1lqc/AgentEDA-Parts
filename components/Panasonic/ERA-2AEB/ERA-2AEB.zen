    48700000000: "ERA2AEB4872X",  # 48700 ohm
    49900000000: "ERA2AEB4992X",  # 49900 ohm
    51000000000: "ERA2AEB513X",  # 51000 ohm
    51100000000: "ERA2AEB5112X",  # 51100 ohm
    52300000000: "ERA2AEB5232X",  # 52300 ohm
    53600000000: "ERA2AEB5362X",  # 53600 ohm
    54900000000: "ERA2AEB5492X",  # 54900 ohm
    56000000000: "ERA2AEB563X",  # 56000 ohm
    56200000000: "ERA2AEB5622X",  # 56200 ohm
    57600000000: "ERA2AEB5762X",  # 57600 ohm
    59000000000: "ERA2AEB5902X",  # 59000 ohm
    60400000000: "ERA2AEB6042X",  # 60400 ohm
    61900000000: "ERA2AEB6192X",  # 61900 ohm
    62000000000: "ERA2AEB623X",  # 62000 ohm
    63400000000: "ERA2AEB6342X",  # 63400 ohm
    64900000000: "ERA2AEB6492X",  # 64900 ohm
    66500000000: "ERA2AEB6652X",  # 66500 ohm
    68000000000: "ERA2AEB683X",  # 68000 ohm
    68100000000: "ERA2AEB6812X",  # 68100 ohm
    69800000000: "ERA2AEB6982X",  # 69800 ohm
    71500000000: "ERA2AEB7152X",  # 71500 ohm
    73200000000: "ERA2AEB7322X",  # 73200 ohm
    75000000000: "ERA2AEB753X",  # 75000 ohm
    76800000000: "ERA2AEB7682X",  # 76800 ohm
    78700000000: "ERA2AEB7872X",  # 78700 ohm
    80600000000: "ERA2AEB8062X",  # 80600 ohm
    82000000000: "ERA2AEB823X",  # 82000 ohm
    82500000000: "ERA2AEB8252X",  # 82500 ohm
    84500000000: "ERA2AEB8452X",  # 84500 ohm
    86600000000: "ERA2AEB8662X",  # 86600 ohm
    88700000000: "ERA2AEB8872X",  # 88700 ohm
    90900000000: "ERA2AEB9092X",  # 90900 ohm
    91000000000: "ERA2AEB913X",  # 91000 ohm
    93100000000: "ERA2AEB9312X",  # 93100 ohm
    95300000000: "ERA2AEB9532X",  # 95300 ohm
    97600000000: "ERA2AEB9762X",  # 97600 ohm
    100000000000: "ERA2AEB104X",  # 100000 ohm
}
_KEY = int(value.value * 1e6 + 0.5)
# Part number for an allowed value; any other value takes the first entry and fails value_allowed below.
_MPN_STR = _MPN.get(_KEY, _MPN[47000000])


def _allowed(_m, r, what):
    check(
        _KEY in _MPN,
        "%s: %s ohm is not an allowed value (E24/E96 values from 47 to 100000 ohm (E96 only from 100 ohm))" % (what, r),
    )


_ALLOWED_SEVERITY = "advice" if _ROOT else "error"  # standalone build: value is unset
builtin.add_electrical_check(
    name="value_allowed",
    check_fn=_allowed,
    inputs={"r": value.value, "what": "value_allowed"},
    severity=_ALLOWED_SEVERITY,
)


def _rated_voltage(_m, v1, v2, what, r, p, vlim, derate):
    # Worst case |V(P1) - V(P2)| over both nets' ranges. Zener has no sqrt, so compare squares:
    # vmax <= derate x min(sqrt(P x R), vlim)  <=>  vmax^2 <= derate^2 x min(P x R, vlim^2).
    vmax = max(v1.max - v2.min, v2.max - v1.min)
    limit2 = min(p * r, vlim * vlim) * derate * derate
    msg = "%s: up to %s V across the part, (V across)^2 = %s V^2 > %s V^2 = derate^2 x min(P x R, Vlimit^2) with R = %s ohm, P = %s W, Vlimit = %s V"
    check(vmax * vmax <= limit2, msg % (what, vmax, vmax * vmax, limit2, r, p, vlim))


# category_temp_ambient: board ambient range inside this range
#   Category temperature range: min -55 / max 155 degC
#   DS p.20, Ratings, Category temperature range (degC), all rows of the table (also DS p.19 Features)
#   Severity error: rec_op violated
_limit(
    "category_temp_ambient", _temp, {"v": ambient, "what": "category_temp_ambient", "lo": 218.15, "hi": 428.15}, "error"
)

# rated_voltage: voltage across the part within min(sqrt(P x R), Vlimit), x derate
#   Power rating p85: Power rating at 85 degC: max 0.063 W (DS p.20, Ratings, Power rating (85 degC) (W), ERA2AEB row)
#   Voltage limit v_limit: Limiting element voltage: max 50 V (DS p.20, Ratings, Limiting element voltage (V), ERA2AEB row)
#   Evaluated for the configured value. Error: a rated part voltage is exceeded.
#   Not checked here: power derating above 70 degC (curve) is the module's job, calc.rated_power;
#   above 70 degC ambient this check is optimistic.
_limit(
    "rated_voltage",
    _rated_voltage,
    {
        "v1": P1.voltage,
        "v2": P2.voltage,
        "what": "rated_voltage",
        "r": value.value,
        "p": 0.063,
        "vlim": 50.0,
        "derate": derate,
    },
    "error",
)

Component(
    name="ERA-2AEB",
    symbol=Symbol(library="./ERA-2AEB.kicad_sym"),
    part=Part(mpn=_MPN_STR, manufacturer="Panasonic"),
    pins={
        "1": P1,
        "2": P2,
    },
)
