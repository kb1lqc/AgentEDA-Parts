"""WSK2512 datasheet limits and equations for WSK2512R0250D (0.025 ohm, ±0.5 %), shared by WSK2512R0250D.zen and
by modules (load() this file). DS: https://www.vishay.com/doc?30108, Document 30108, Revision 11-Dec-2023.
Raw datasheet values, never derated here. The DS has no Absolute Maximum Ratings or Recommended Operating table: the
ratings are the Standard Electrical Specifications (DS p.1), Technical Specifications (DS p.2) and DERATING (DS p.3).
Range-dependent values use the "0.005 to 0.2" ohm row, the one covering 0.025 ohm; do not reuse them for other values.
Power and temperature are rated against AMBIENT temperature (DS p.3 DERATING axis), not element temperature.
Helpers return plain floats in SI units (ohm, W, V, A) and take temperatures in °C as floats."""

load("@stdlib/units.zen", "Temperature")

TA_GRADE = Temperature("-65°C to 170°C")  # DS p.2, Technical Specifications, Operating temperature range
R_NOM = 0.025  # ohm, DS p.1, Global Part Number Information, resistance code R0250
TOL = 0.005  # fraction, DS p.1, tolerance code D = ±0.5 % (reference temperature not stated, 25 °C assumed)
# DS p.2, Technical Specifications, Temperature coefficient, 0.005 to 0.2 ohm row: ±35 ppm/°C. DS p.1 Features says
# "TCR (< 20 ppm/°C)": the specification table (looser) is used. Reference temperature not stated, 25 °C assumed.
# The temperature span over which the TCR holds is not stated either: r_range applies it linearly over the whole
# -65 °C to 170 °C operating range, an extrapolation the DS does not confirm (open item).
TCR = 35e-6  # per °C
T_REF_C = 25.0  # °C, ASSUMPTION: the DS states no reference temperature for tolerance or TCR
P70 = 1.0  # W, DS p.1, Standard Electrical Specifications, power rating P70 °C
TA_MIN_C = -65.0  # °C, DS p.2, Technical Specifications, Operating temperature range (float copy of TA_GRADE.min)
TA_KNEE_C = 70.0  # °C, DS p.3, DERATING: 100 % rated power up to 70 °C (and P70 °C, DS p.1)
TA_ZERO_C = 170.0  # °C, DS p.3, DERATING: 0 % at 170 °C (read from the graph; equals the DS p.2 operating max)

# Performance test limits (DS p.3, PERFORMANCE, "TEST LIMITS"): maximum resistance change as (fraction, ohm), the
# change being fraction x R + ohm. The DS note says typical performance is better, so these are bounds, not typicals.
# Each holds only under its listed test condition; the DS gives no end-of-life guarantee for other conditions.
# short_time_overload: the DS gives the limit but not the overload level (external link), so do not apply it to any
# specific overload. Pulse capability has no numbers in the DS (online calculator only): not provided.
DRIFT = {
    "thermal_shock": (0.005, 0.0005),  # -55 °C to +150 °C, 1000 cycles, 15 min at each extreme
    "short_time_overload": (0.005, 0.0005),  # overload level by external link only
    "low_temp_operation": (0.005, 0.0005),  # -65 °C for 24 h
    "high_temp_exposure": (0.010, 0.0005),  # 1000 h at +170 °C
    "bias_humidity": (0.005, 0.0005),  # +85 °C, 85 % RH, 10 % bias, 1000 h
    "mechanical_shock": (0.005, 0.0005),  # 100 g, 6 ms, 5 pulses
    "vibration": (0.005, 0.0005),  # 10 Hz to 2000 Hz, 3 directions, 12 h
    "load_life": (0.010, 0.0005),  # 1000 h at rated power, +70 °C, 1.5 h on / 0.5 h off
    "solder_heat": (0.005, 0.0005),  # +260 °C, 10 s to 12 s dwell
    "moisture_resistance": (0.005, 0.0005),  # MIL-STD-202 method 106, 0 % power
}
# Inductance "0.5 nH to 5 nH" (DS p.1 Features): a feature claim with no conditions, never a bound.


def _sqrt(x):  # this Starlark has no ** operator and no math module (tested on 0.4.99): Newton iteration
    if x <= 0:  # 100 steps converge for 1e-30 <= x <= 1e30 (40 did not at the extremes)
        return 0.0
    g = x if x > 1 else 1.0
    for _ in range(100):
        g = (g + x / g) / 2
    return g


def p_rated(ta_c):
    """Rated power in W at ambient ta_c (°C): P70 up to 70 °C, linear to 0 W at 170 °C (DS p.3 DERATING, DS p.1 P70).
    The module multiplies by its derate factor; this function never derates."""
    check(ta_c >= TA_MIN_C and ta_c <= TA_ZERO_C, "ta_c outside the -65 °C to 170 °C operating range")
    if ta_c <= TA_KNEE_C:
        return P70
    return P70 * (TA_ZERO_C - ta_c) / (TA_ZERO_C - TA_KNEE_C)


def r_range(t_lo_c, t_hi_c):
    """(min, max) resistance in ohms over tolerance and TCR for a resistor temperature range in °C (DS p.1 code D,
    DS p.2 TCR), measured from the assumed 25 °C reference. Self-heating raises the element above ambient and the DS
    gives no thermal resistance or temperature rise at rated power: never pass the ambient range as the resistor
    temperature; the module must obtain the rise from Vishay (DS p.1 contact) or measurement (open item)."""
    check(t_lo_c <= t_hi_c, "t_lo_c must be <= t_hi_c")
    dt = max(abs(t_lo_c - T_REF_C), abs(t_hi_c - T_REF_C))
    return (R_NOM * (1 - TOL) * (1 - TCR * dt), R_NOM * (1 + TOL) * (1 + TCR * dt))


def p_diss(i, r_max):
    """Dissipation in W for a current magnitude i (A, either sign) at the largest resistance r_max (ohm): I^2 x R."""
    return i * i * r_max


def i_max(p_w, r_max):
    """Largest continuous current magnitude in A for an allowed power p_w (W) at the largest resistance r_max (ohm):
    sqrt(P / R), the DS p.2 maximum working voltage (P x R)^1/2 restated as current. Pass
    p_w = p_rated(ta_c) x derate (the module applies its derate; this file never derates)."""
    check(p_w >= 0 and r_max > 0, "p_w must be >= 0 and r_max > 0")
    return _sqrt(p_w / r_max)


def v_max(p_w, r_min):
    """Maximum working voltage across the resistor in V: (P x R)^1/2 (DS p.2) for an allowed power p_w (W), at the
    smallest resistance r_min (ohm) for a safe bound. Pass p_w = p_rated(ta_c) x derate."""
    check(p_w >= 0 and r_min > 0, "p_w must be >= 0 and r_min > 0")
    return _sqrt(p_w * r_min)


def v_sense(i, r_lo, r_hi):
    """(min, max) E1-to-E2 voltage in V for a current i (A) flowing from I1 to I2 (positive) over a resistance range
    (r_lo, r_hi) from r_range(). Negative current (I2 to I1) gives negative voltages; the pair is sorted."""
    a, b = i * r_lo, i * r_hi
    return (min(a, b), max(a, b))


def drift_max(name):
    """Largest fractional resistance change for a DS p.3 PERFORMANCE test (DRIFT key) at R_NOM:
    fraction + ohm / R_NOM (load_life: 0.010 + 0.0005 / 0.025 = 0.030, i.e. 3 %)."""
    check(name in DRIFT, "unknown DRIFT test: " + name)
    f, o = DRIFT[name]
    return f + o / R_NOM
