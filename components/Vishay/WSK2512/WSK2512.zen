    98000: ["B", "D", "F"],
    99000: ["B", "D", "F"],
    100000: ["B", "D", "F"],
    110000: ["B", "D", "F"],
    120000: ["B", "D", "F"],
    130000: ["B", "D", "F"],
    140000: ["B", "D", "F"],
    150000: ["B", "D", "F"],
    160000: ["B", "D", "F"],
    170000: ["B", "D", "F"],
    180000: ["B", "D", "F"],
    190000: ["B", "D", "F"],
    200000: ["B", "D", "F"],
}
_KEY = int(value.value * 1e6 + 0.5)
_AVAILABLE = _CODES.get(_KEY, [])
_CODE = tolerance if tolerance != "" or len(_AVAILABLE) != 1 else _AVAILABLE[0]
# An unorderable (value, tolerance) gets the sentinel MPN UNORDERABLE (never a real but wrong part number).
_MPN_STR = _MPN.get((_KEY, _CODE), "UNORDERABLE")


def _allowed(_m, found, what, r, code, available):
    why = "%s: %s ohm with tolerance code %s is not orderable (VISHAY-DECADE values per tolerance code: B 0.01 to 0.2 ohm, D 0.005 to 0.2 ohm, F 0.005 to 0.2 ohm)"
    if len(available) > 0:
        why += "; the tolerance codes that allow this value: %s (set tolerance)" % available
    check(found, why % (what, r, code))


_ALLOWED_SEVERITY = "advice" if _ROOT else "error"  # standalone build: value is unset
builtin.add_electrical_check(
    name="value_allowed",
    check_fn=_allowed,
    inputs={
        "found": (_KEY, _CODE) in _MPN,
        "what": "value_allowed",
        "r": value.value,
        "code": _CODE,
        "available": _AVAILABLE,
    },
    severity=_ALLOWED_SEVERITY,
)


def _rated_voltage(_m, v1, v2, what, r, p, derate):
    # Worst case |V(P1) - V(P2)| over both nets' ranges. Zener has no sqrt, so compare squares:
    # vmax <= derate x sqrt(P x R)  <=>  vmax^2 <= derate^2 x P x R. The datasheet prints no Vlimit.
    vmax = max(v1.max - v2.min, v2.max - v1.min)
    limit2 = p * r * derate * derate
    msg = "%s: up to %s V across the part, (V across)^2 = %s V^2 > %s V^2 = derate^2 x P x R with R = %s ohm, P = %s W"
    check(vmax * vmax <= limit2, msg % (what, vmax, vmax * vmax, limit2, r, p))


# t_oper_ambient: board ambient range inside this range
#   Operating temperature range: min -65 / max 170 degC
#   DS p.2, Technical Specifications, Operating temperature range, -65 to +170
#   Severity error: rec_op violated
_limit("t_oper_ambient", _temp, {"v": ambient, "what": "t_oper_ambient", "lo": 208.15, "hi": 443.15}, "error")

# rated_voltage: voltage across the part within sqrt(P x R), x derate
#   Power rating p70: Power rating at 70 degC ambient: max 1.0 W (DS p.1, Standard Electrical Specifications, POWER RATING P70 degC, W, 1.0)
#   No limiting element voltage: the datasheet prints none.
#   Evaluated for the configured value. Error: a rated part voltage is exceeded.
#   Not checked here: power derating above 70 degC (curve) is the module's job, calc.rated_power;
#   above 70 degC ambient this check is optimistic.
_limit(
    "rated_voltage",
    _rated_voltage,
    {"v1": I1.voltage, "v2": I2.voltage, "what": "rated_voltage", "r": value.value, "p": 1.0, "derate": derate},
    "error",
)

Component(
    name="WSK2512",
    symbol=Symbol(library="./WSK2512.kicad_sym"),
    part=Part(mpn=_MPN_STR, manufacturer="Vishay Dale", datasheet="https://www.vishay.com/doc?30108"),
    pins={
        "I2": I2,
        "E2": E2,
        "E1": E1,
        "I1": I1,
    },
)
